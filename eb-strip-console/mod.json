{
  "manifest_version": 2,
  "mod": {
    "id": "eb-strip-console",
    "name": "Devices: EB Strip Console",
    "version": "0.9.1",
    "author": "Scott",
    "description": "Companion for the EB BlackStrip channel strip: loads the unit each slot names, links the macro knobs, swaps slots, keeps A/B snapshots, opens the expanded view, runs strip-wide 2x oversampling and serves the F1 help of every EB device.",
    "area": "Device",
    "homepage": "https://github.com/redtile21/patchbay-mods/tree/main/channel-strip",
    "documentation": "readme",
    "tags": [
      "channel strip",
      "mixing",
      "nitro",
      "EB BlackStrip"
    ]
  },
  "built_against": {
    "bitwig_version": "6.1.7",
    "platform": "macos",
    "architecture": "universal"
  },
  "requires": [
    {
      "id": "action-menu-composition-framework",
      "min_version": "0.8.0-dev.1"
    },
    {
      "id": "notifications-framework",
      "min_version": "0.3.0-dev.1"
    },
    {
      "id": "custom-device-registrar",
      "min_version": "1.3.0-dev.3"
    }
  ],
  "resources": {
    "readme": {
      "kind": "file",
      "path": "README.md",
      "media_type": "text/markdown"
    },
    "strip_icon": {
      "kind": "file",
      "path": "icons/eb-strip.svg",
      "media_type": "image/svg+xml"
    }
  },
  "registrations": [
    {
      "id": "actions",
      "consumer": "action-menu-composition-framework",
      "descriptor": "actions.properties",
      "jar": "helper.jar"
    }
  ]
}
