component eb_saturation
{
    audio_inport in;
    audio_inport f32 drive = 0.0;
    audio_inport f32 bias = 0.0;
    audio_inport f32 tone = 0.0;
    audio_inport f32 mix = 100.0;
    audio_inport f32 output = 0.0;
    value_inport i32 sat_type;
    value_inport bool auto_gain;
    value_inport bool oversampling;

    audio_outport out;
    audio_outport f32<4> display;
    audio_outport f32<4> display2;

    f32 prev_l = 0.0;
    f32 prev_r = 0.0;
    f32 lp_l = 0.0;
    f32 lp_r = 0.0;
    f32 meter_l = 0.0;
    f32 meter_r = 0.0;
    f32 in_env = 0.0;
    f32 in_pk = 0.0;
    f32 out_pk = 0.0;
    f32 t_in = 0.0;
    f32 t_out = 0.0;
    f32 tl_l = 0.0;
    f32 tl_r = 0.0;
    f32 tc_l = 0.0;
    f32 tc_r = 0.0;
    f32 xh_l = 0.0;
    f32 xh_r = 0.0;
    f32 dc_l = 0.0;
    f32 dc_r = 0.0;
    f32 xe_l = 0.0;
    f32 xe_r = 0.0;

    f32 dbgain(f32 v)
    {
        return exp(v * 0.11512925464970229);
    }
    f32 bound(f32 v, f32 lo, f32 hi)
    {
        return fmax(lo, fmin(hi, v));
    }
    f32 tanh_(f32 v)
    {
        f32 e = exp(2.0 * bound(v, -12.0, 12.0));
        return (e - 1.0) / (e + 1.0);
    }
    f32 shape(f32 v, f32 kind)
    {
        f32 r = 0.0;
        if (kind < 0.5)
        {
            r = tanh_(v);
        }
        else
        {
            if (kind < 1.5)
            {
                if (v >= 0.0)
                {
                    r = tanh_(v);
                }
                else
                {
                    r = tanh_(v * 0.7) / 0.7;
                }
            }
            else
            {
                if (kind < 2.5)
                {
                    f32 c = bound(v, -1.0, 1.0);
                    r = 1.5 * c - 0.5 * c * c * c;
                }
                else
                {
                    if (kind < 3.5)
                    {
                        r = bound(v, -1.0, 1.0);
                    }
                    else
                    {
                        if (kind < 4.5)
                        {
                            // Transformer: a soft core, a little asymmetric.
                            if (v >= 0.0)
                            {
                                r = tanh_(v);
                            }
                            else
                            {
                                r = tanh_(v * 0.85) / 0.85;
                            }
                        }
                        else
                        {
                            if (kind < 5.5)
                            {
                                // Console: a gentler knee than tanh.
                                r = v / sqrt(1.0 + v * v);
                            }
                            else
                            {
                                r = tanh_(v);
                            }
                        }
                    }
                }
            }
        }
        return r;
    }

    reset
    {
        prev_l = 0.0;
        prev_r = 0.0;
        lp_l = 0.0;
        lp_r = 0.0;
        meter_l = 0.0;
        meter_r = 0.0;
        in_env = 0.0;
        in_pk = 0.0;
        out_pk = 0.0;
        t_in = 0.0;
        t_out = 0.0;
        tl_l = 0.0;
        tl_r = 0.0;
        tc_l = 0.0;
        tc_r = 0.0;
        xh_l = 0.0;
        xh_r = 0.0;
        dc_l = 0.0;
        dc_r = 0.0;
        xe_l = 0.0;
        xe_r = 0.0;
    }

    process
    {
        f32<> x = in;
        f32 sr = EC.samplerate;
        f32 dr = bound(drive, 0.0, 36.0);
        f32 drive_lin = dbgain(dr);
        f32 kind = cast(sat_type, f32);
        f32 bias_v = bound(bias, -1.0, 1.0) * 0.5;
        f32 bias_off = shape(bias_v, kind);
        f32 tn = bound(tone, -6.0, 6.0);
        f32 tone_lo = dbgain(-tn * 0.5);
        f32 tone_hi = dbgain(tn * 0.5);
        f32 tone_a = 1.0 - exp(-6.283185307 * 1000.0 / sr);
        f32 m = bound(mix, 0.0, 100.0) * 0.01;
        f32 ag = 0.0;
        if (auto_gain && sat_type != 6)
        {
            ag = -dr * 0.6;
        }
        f32 tf_a = 1.0 - exp(-6.283185307 * 150.0 / sr);
        f32 ex_a = 1.0 - exp(-6.283185307 * 3000.0 / sr);
        f32 dc_a = 1.0 - exp(-6.283185307 * 8.0 / sr);
        // Exciter: Drive pushes the high band into tanh; Bias adds even harmonics.
        f32 ex_tb = tanh_(bias_v);
        f32 out_lin = dbgain(bound(output, -24.0, 6.0) + ag);

        // ---- channel l ----
        f32 d_l = x[0] * drive_lin + bias_v;
        if (sat_type == 4)
        {
            // Transformer: the lows (below about 150 Hz) hit the core twice as hard.
            tl_l = tl_l + tf_a * (d_l - tl_l);
            d_l = d_l + tl_l;
        }
        f32 s_l = shape(d_l, kind) - bias_off;
        if (oversampling && sat_type != 6)
        {
            f32 mid_l = (d_l + prev_l) * 0.5;
            s_l = d_l + 0.5 * ((s_l + bias_off - d_l) + (shape(mid_l, kind) - mid_l)) - bias_off;
        }
        prev_l = d_l;
        if (sat_type == 4)
        {
            // Undo the low boost on the way out (half the lows), so the level stays put.
            tc_l = tc_l + tf_a * (s_l - tc_l);
            s_l = s_l - 0.5 * tc_l;
        }
        if (sat_type == 6)
        {
            // Exciter: the dry signal plus harmonics made from the highs (above about 3 kHz) only.
            xh_l = xh_l + ex_a * (x[0] - xh_l);
            f32 hp_l = x[0] - xh_l;
            f32 hm_l = tanh_(drive_lin * hp_l + bias_v) - ex_tb;
            // High-pass the result again so only the upper harmonics are added.
            xe_l = xe_l + ex_a * (hm_l - xe_l);
            s_l = x[0] + 0.15 * (hm_l - xe_l);
        }
        // DC blocker (the asymmetric curves add a small offset)
        dc_l = dc_l + dc_a * (s_l - dc_l);
        s_l = s_l - dc_l;
        // tone: tilt around 1 kHz
        lp_l = lp_l + tone_a * (s_l - lp_l);
        f32 t_l = lp_l * tone_lo + (s_l - lp_l) * tone_hi;
        f32 o_l = (x[0] * (1.0 - m) + t_l * m) * out_lin;

        // ---- channel r ----
        f32 d_r = x[1] * drive_lin + bias_v;
        if (sat_type == 4)
        {
            // Transformer: the lows (below about 150 Hz) hit the core twice as hard.
            tl_r = tl_r + tf_a * (d_r - tl_r);
            d_r = d_r + tl_r;
        }
        f32 s_r = shape(d_r, kind) - bias_off;
        if (oversampling && sat_type != 6)
        {
            f32 mid_r = (d_r + prev_r) * 0.5;
            s_r = d_r + 0.5 * ((s_r + bias_off - d_r) + (shape(mid_r, kind) - mid_r)) - bias_off;
        }
        prev_r = d_r;
        if (sat_type == 4)
        {
            // Undo the low boost on the way out (half the lows), so the level stays put.
            tc_r = tc_r + tf_a * (s_r - tc_r);
            s_r = s_r - 0.5 * tc_r;
        }
        if (sat_type == 6)
        {
            // Exciter: the dry signal plus harmonics made from the highs (above about 3 kHz) only.
            xh_r = xh_r + ex_a * (x[1] - xh_r);
            f32 hp_r = x[1] - xh_r;
            f32 hm_r = tanh_(drive_lin * hp_r + bias_v) - ex_tb;
            // High-pass the result again so only the upper harmonics are added.
            xe_r = xe_r + ex_a * (hm_r - xe_r);
            s_r = x[1] + 0.15 * (hm_r - xe_r);
        }
        // DC blocker (the asymmetric curves add a small offset)
        dc_r = dc_r + dc_a * (s_r - dc_r);
        s_r = s_r - dc_r;
        // tone: tilt around 1 kHz
        lp_r = lp_r + tone_a * (s_r - lp_r);
        f32 t_r = lp_r * tone_lo + (s_r - lp_r) * tone_hi;
        f32 o_r = (x[1] * (1.0 - m) + t_r * m) * out_lin;

        f32<> y = <o_l, o_r>;
        out = y;
        meter_l = fmax(fabs(o_l), meter_l * 0.999);
        meter_r = fmax(fabs(o_r), meter_r * 0.999);
        f32 pin = fmax(fabs(x[0]), fabs(x[1]));
        f32 pout = fmax(fabs(o_l), fabs(o_r));
        in_env = fmax(pin, in_env * 0.999);
        f32 hold_len = 5.0 * sr;
        if (pin >= in_pk)
        {
            in_pk = pin;
            t_in = 0.0;
        }
        else
        {
            t_in = t_in + 1.0;
            if (t_in > hold_len)
            {
                in_pk = pin;
                t_in = 0.0;
            }
        }
        if (pout >= out_pk)
        {
            out_pk = pout;
            t_out = 0.0;
        }
        else
        {
            t_out = t_out + 1.0;
            if (t_out > hold_len)
            {
                out_pk = pout;
                t_out = 0.0;
            }
        }
        f32 ine = bound((20.0 * log10(fmax(0.000001, in_env)) + 60.0) / 66.0, 0.0, 1.0);
        f32 oute = bound((20.0 * log10(fmax(0.000001, fmax(meter_l, meter_r))) + 60.0) / 66.0, 0.0, 1.0);
        f32 inp = bound((20.0 * log10(fmax(0.000001, in_pk)) + 60.0) / 66.0, 0.0, 1.0);
        f32 outp = bound((20.0 * log10(fmax(0.000001, out_pk)) + 60.0) / 66.0, 0.0, 1.0);
        // Type and mix share a lane: floor(lane * 8) = type, fract(lane * 8) = mix.
        f32 tm = (kind + m * 0.99) / 8.0;
        display = <dr / 36.0, (bound(bias, -1.0, 1.0) + 1.0) * 0.5, tm, ine>;
        display2 = <oute, inp, outp, 0.0>;
    }
}
