// audioLow:    low band, low-mid, high-mid, high band codes: shape*1310720 + gain_index*4096 + freq_index, divided by 2^24
//              (gain = index*0.1 - 15 dB, freq = 20 * 10^(index/4095*3) Hz, shape 1 = bell)
// audioMedium: high-pass index * 4096 + low-pass index (index 0 = off), low-mid Q index * 512 + high-mid Q index,
//              low Q index * 512 + high Q index (Q = 0.4 + index/100),
//              air * 64 + mode * 16 + high-pass slope * 4 + low-pass slope
uniform float4 audioLow;
uniform float4 audioMedium;

float sdseg(float2 p, float2 a, float2 b) {
    float2 pa = p - a;
    float2 ba = b - a;
    float h = clamp(dot(pa, ba) / dot(ba, ba), 0., 1.);
    return length(pa - ba * h);
}
// Monoline sans-serif digit in a 1 x 2 box; d < 0 draws nothing.
float digit(float2 q, float d) {
    if (d < 0.) return 0.;
    float m = 10.;
    if (d < 0.5) {
        m = min(m, sdseg(q, float2(0.25, 0.05), float2(0.75, 0.05)));
        m = min(m, sdseg(q, float2(0.75, 0.05), float2(0.92, 0.35)));
        m = min(m, sdseg(q, float2(0.92, 0.35), float2(0.92, 1.65)));
        m = min(m, sdseg(q, float2(0.92, 1.65), float2(0.75, 1.95)));
        m = min(m, sdseg(q, float2(0.75, 1.95), float2(0.25, 1.95)));
        m = min(m, sdseg(q, float2(0.25, 1.95), float2(0.08, 1.65)));
        m = min(m, sdseg(q, float2(0.08, 1.65), float2(0.08, 0.35)));
        m = min(m, sdseg(q, float2(0.08, 0.35), float2(0.25, 0.05)));
    }
    else if (d < 1.5) {
        m = min(m, sdseg(q, float2(0.18, 0.45), float2(0.55, 0.05)));
        m = min(m, sdseg(q, float2(0.55, 0.05), float2(0.55, 1.95)));
    }
    else if (d < 2.5) {
        m = min(m, sdseg(q, float2(0.1, 0.4), float2(0.25, 0.1)));
        m = min(m, sdseg(q, float2(0.25, 0.1), float2(0.5, 0.05)));
        m = min(m, sdseg(q, float2(0.5, 0.05), float2(0.75, 0.1)));
        m = min(m, sdseg(q, float2(0.75, 0.1), float2(0.9, 0.4)));
        m = min(m, sdseg(q, float2(0.9, 0.4), float2(0.85, 0.75)));
        m = min(m, sdseg(q, float2(0.85, 0.75), float2(0.1, 1.95)));
        m = min(m, sdseg(q, float2(0.1, 1.95), float2(0.92, 1.95)));
    }
    else if (d < 3.5) {
        m = min(m, sdseg(q, float2(0.12, 0.12), float2(0.5, 0.05)));
        m = min(m, sdseg(q, float2(0.5, 0.05), float2(0.85, 0.25)));
        m = min(m, sdseg(q, float2(0.85, 0.25), float2(0.85, 0.65)));
        m = min(m, sdseg(q, float2(0.85, 0.65), float2(0.45, 0.95)));
        m = min(m, sdseg(q, float2(0.45, 0.95), float2(0.88, 1.25)));
        m = min(m, sdseg(q, float2(0.88, 1.25), float2(0.9, 1.7)));
        m = min(m, sdseg(q, float2(0.9, 1.7), float2(0.5, 1.95)));
        m = min(m, sdseg(q, float2(0.5, 1.95), float2(0.1, 1.85)));
    }
    else if (d < 4.5) {
        m = min(m, sdseg(q, float2(0.75, 1.95), float2(0.75, 0.05)));
        m = min(m, sdseg(q, float2(0.75, 0.05), float2(0.05, 1.35)));
        m = min(m, sdseg(q, float2(0.05, 1.35), float2(0.95, 1.35)));
    }
    else if (d < 5.5) {
        m = min(m, sdseg(q, float2(0.9, 0.05), float2(0.2, 0.05)));
        m = min(m, sdseg(q, float2(0.2, 0.05), float2(0.12, 0.95)));
        m = min(m, sdseg(q, float2(0.12, 0.95), float2(0.5, 0.85)));
        m = min(m, sdseg(q, float2(0.5, 0.85), float2(0.85, 0.95)));
        m = min(m, sdseg(q, float2(0.85, 0.95), float2(0.92, 1.5)));
        m = min(m, sdseg(q, float2(0.92, 1.5), float2(0.75, 1.9)));
        m = min(m, sdseg(q, float2(0.75, 1.9), float2(0.45, 1.97)));
        m = min(m, sdseg(q, float2(0.45, 1.97), float2(0.1, 1.8)));
    }
    else if (d < 6.5) {
        m = min(m, sdseg(q, float2(0.85, 0.15), float2(0.5, 0.05)));
        m = min(m, sdseg(q, float2(0.5, 0.05), float2(0.18, 0.35)));
        m = min(m, sdseg(q, float2(0.18, 0.35), float2(0.1, 1.0)));
        m = min(m, sdseg(q, float2(0.1, 1.0), float2(0.1, 1.6)));
        m = min(m, sdseg(q, float2(0.1, 1.6), float2(0.4, 1.95)));
        m = min(m, sdseg(q, float2(0.4, 1.95), float2(0.75, 1.9)));
        m = min(m, sdseg(q, float2(0.75, 1.9), float2(0.92, 1.55)));
        m = min(m, sdseg(q, float2(0.92, 1.55), float2(0.8, 1.15)));
        m = min(m, sdseg(q, float2(0.8, 1.15), float2(0.45, 1.05)));
        m = min(m, sdseg(q, float2(0.45, 1.05), float2(0.12, 1.3)));
    }
    else if (d < 7.5) {
        m = min(m, sdseg(q, float2(0.08, 0.05), float2(0.92, 0.05)));
        m = min(m, sdseg(q, float2(0.92, 0.05), float2(0.4, 1.95)));
    }
    else if (d < 8.5) {
        m = min(m, sdseg(q, float2(0.5, 0.95), float2(0.15, 0.7)));
        m = min(m, sdseg(q, float2(0.15, 0.7), float2(0.15, 0.3)));
        m = min(m, sdseg(q, float2(0.15, 0.3), float2(0.5, 0.05)));
        m = min(m, sdseg(q, float2(0.5, 0.05), float2(0.85, 0.3)));
        m = min(m, sdseg(q, float2(0.85, 0.3), float2(0.85, 0.7)));
        m = min(m, sdseg(q, float2(0.85, 0.7), float2(0.5, 0.95)));
        m = min(m, sdseg(q, float2(0.5, 0.95), float2(0.1, 1.25)));
        m = min(m, sdseg(q, float2(0.1, 1.25), float2(0.1, 1.7)));
        m = min(m, sdseg(q, float2(0.1, 1.7), float2(0.5, 1.95)));
        m = min(m, sdseg(q, float2(0.5, 1.95), float2(0.9, 1.7)));
        m = min(m, sdseg(q, float2(0.9, 1.7), float2(0.9, 1.25)));
        m = min(m, sdseg(q, float2(0.9, 1.25), float2(0.5, 0.95)));
    }
    else {
        m = min(m, sdseg(q, float2(0.15, 1.85), float2(0.5, 1.95)));
        m = min(m, sdseg(q, float2(0.5, 1.95), float2(0.82, 1.65)));
        m = min(m, sdseg(q, float2(0.82, 1.65), float2(0.9, 1.0)));
        m = min(m, sdseg(q, float2(0.9, 1.0), float2(0.9, 0.4)));
        m = min(m, sdseg(q, float2(0.9, 0.4), float2(0.6, 0.05)));
        m = min(m, sdseg(q, float2(0.6, 0.05), float2(0.25, 0.1)));
        m = min(m, sdseg(q, float2(0.25, 0.1), float2(0.08, 0.45)));
        m = min(m, sdseg(q, float2(0.08, 0.45), float2(0.2, 0.85)));
        m = min(m, sdseg(q, float2(0.2, 0.85), float2(0.55, 0.95)));
        m = min(m, sdseg(q, float2(0.55, 0.95), float2(0.88, 0.7)));
    }
    return 1. - smoothstep(.09, .16, m);
}

// Magnitudes come from the analog prototypes evaluated at x = tan(w/2) / tan(w0/2), which is exactly what the
// bilinear-transformed biquads do and stays accurate at very low frequencies.
float xr(float tw, float f0) {
    return tw / tan(3.1415927 * clamp(f0, 10., 22000.) / 48000.);
}
float peakdb(float g, float f, float q, float tw) {
    float x = xr(tw, f);
    float x2 = x * x;
    float A = pow(10., g / 40.);
    float qq = max(q, .1);
    float u = (1. - x2) * (1. - x2);
    return 10. * log((u + x2 * A * A / (qq * qq)) / (u + x2 / (A * A * qq * qq))) / 2.302585;
}
float shelfdb(float g, float f, float q, float tw, bool low) {
    float x = xr(tw, f);
    float x2 = x * x;
    float A = pow(10., g / 40.);
    float k2 = A / (q * q);
    float n; float d;
    if (low) {
        n = (A - x2) * (A - x2) + x2 * k2;
        d = (1. - A * x2) * (1. - A * x2) + x2 * k2;
    } else {
        n = (1. - A * x2) * (1. - A * x2) + x2 * k2;
        d = (A - x2) * (A - x2) + x2 * k2;
    }
    return 10. * log(A * A * n / d) / 2.302585;
}
float passdb(float f, float tw, bool high, float slope) {
    float x = xr(tw, f);
    float x2 = x * x;
    float num = high ? x2 : 1.;
    if (slope < .5) {
        return 10. * log(num / (1. + x2)) / 2.302585;
    }
    float n2 = high ? x2 * x2 : 1.;
    if (slope < 1.5) {
        return 10. * log(n2 / ((1. - x2) * (1. - x2) + x2 * 2.)) / 2.302585;
    }
    float d1 = (1. - x2) * (1. - x2) + x2 * 3.414214;
    float d2 = (1. - x2) * (1. - x2) + x2 * .585786;
    return 10. * log(n2 * n2 / (d1 * d2)) / 2.302585;
}

float bq(float q, float g, float md) {
    float r = q;
    if (md > .5 && md < 1.5) r = min(8., q * (.4 + .12 * abs(g)));
    if (md > 1.5) r = q * .6;
    return max(r, .1);
}
float sq(float q, float md) {
    float r = q;
    if (md > .5 && md < 1.5) r = min(4., q * 1.4);
    if (md > 1.5) r = q * .7;
    return max(r, .1);
}

half4 main(float2 fragCoord) {
    float2 uv = fragCoord / iResolution.xy;
    // Display x axis: semitones 15..135 (A4 = 69 at 440 Hz); y axis: +18 dB at the top, -42 dB at the bottom.
    float note = 15. + uv.x * 120.;
    float f = 440. * pow(2., (note - 69.) / 12.);
    float w = tan(3.1415927 * f / 48000.);
    float c0 = audioLow.x * 16777216.;
    float c1 = audioLow.y * 16777216.;
    float c2 = audioLow.z * 16777216.;
    float c3 = audioLow.w * 16777216.;
    float bellL = floor(c0 / 1310720. + .0001);
    float r0 = c0 - bellL * 1310720.;
    float gL = floor(r0 / 4096.);
    float fL = 20. * pow(10., (r0 - gL * 4096.) / 4095. * 3.);
    float gM = floor(c1 / 4096.);
    float fM = 20. * pow(10., (c1 - gM * 4096.) / 4095. * 3.);
    float gN = floor(c2 / 4096.);
    float fN = 20. * pow(10., (c2 - gN * 4096.) / 4095. * 3.);
    float bellH = floor(c3 / 1310720. + .0001);
    float r3 = c3 - bellH * 1310720.;
    float gH = floor(r3 / 4096.);
    float fH = 20. * pow(10., (r3 - gH * 4096.) / 4095. * 3.);
    float e0 = audioMedium.x * 16777216.;
    float hpIdx = floor(e0 / 4096.);
    float lpIdx = e0 - hpIdx * 4096.;
    float e1 = audioMedium.y * 16777216.;
    float lmqIdx = floor(e1 / 512.);
    float hmqIdx = e1 - lmqIdx * 512.;
    float e2 = audioMedium.z * 16777216.;
    float lqIdx = floor(e2 / 512.);
    float hqIdx = e2 - lqIdx * 512.;

    float e3 = audioMedium.w * 16777216.;
    float airv = floor(e3 / 64. + .0001);
    e3 -= airv * 64.;
    float md = floor(e3 / 16. + .0001);
    e3 -= md * 16.;
    float hs = floor(e3 / 4. + .0001);
    float ls = floor(e3 - hs * 4. + .5);
    float total = 0.;
    if (hpIdx >= 1.) total += passdb(20. * pow(10., hpIdx / 4095. * 3.), w, true, hs);
    if (lpIdx < 4094.) total += passdb(20. * pow(10., lpIdx / 4095. * 3.), w, false, ls);
    float dbL = gL * .1 - 15.;
    float dbM = gM * .1 - 15.;
    float dbN = gN * .1 - 15.;
    float dbH = gH * .1 - 15.;
    total += bellL > .5 ? peakdb(dbL, fL, bq(.4 + lqIdx * .01, dbL, md), w) : shelfdb(dbL, fL, sq(.4 + lqIdx * .01, md), w, true);
    if (md > 1.5 && bellL < .5 && dbL > 0.) total += peakdb(-.4 * dbL, fL * 2.5, .9, w);
    total += peakdb(dbM, fM, bq(.4 + lmqIdx * .01, dbM, md), w);
    total += peakdb(dbN, fN, bq(.4 + hmqIdx * .01, dbN, md), w);
    total += bellH > .5 ? peakdb(dbH, fH, bq(.4 + hqIdx * .01, dbH, md), w) : shelfdb(dbH, fH, sq(.4 + hqIdx * .01, md), w, false);
    if (airv > .5) total += shelfdb(2. * airv, 14000., .5, w, false);
    total = clamp(total, -40., 16.);

    float py = uv.y * iResolution.y;
    float cy = (18. - total) / 60. * iResolution.y;
    float zy = (18. / 60.) * iResolution.y;
    float a = 0.;
    float3 col = float3(1., .86, .45);
    float dist = abs(py - cy);
    if (dist < 1.6) {
        a = 1.;
    } else if (dist < 2.6) {
        a = 2.6 - dist;
    }
    if (a < .2 && py >= min(cy, zy) && py <= max(cy, zy)) a = .16;
    if (abs(py - zy) < .7 && a < .3) {
        a = .25;
        col = float3(.8, .85, .9);
    }
    float lit = digit((fragCoord - float2(iResolution.x - 12., iResolution.y - 14.)) / 4., 12.);
    if (lit > .5 && a < .5) {
        a = .6;
        col = float3(.8, .85, .9);
    }
    return half4(half3(col * a), half(a));
}
