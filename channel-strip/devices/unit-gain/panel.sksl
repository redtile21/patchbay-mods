        m = min(m, sdseg(q, float2(0.707, 0.932), float2(0.655, 0.993)));
        m = min(m, sdseg(q, float2(0.655, 0.993), float2(0.596, 1.036)));
        m = min(m, sdseg(q, float2(0.596, 1.036), float2(0.532, 1.057)));
        m = min(m, sdseg(q, float2(0.532, 1.057), float2(0.468, 1.057)));
        m = min(m, sdseg(q, float2(0.468, 1.057), float2(0.404, 1.036)));
        m = min(m, sdseg(q, float2(0.404, 1.036), float2(0.345, 0.993)));
        m = min(m, sdseg(q, float2(0.345, 0.993), float2(0.293, 0.932)));
        m = min(m, sdseg(q, float2(0.293, 0.932), float2(0.249, 0.854)));
