        m = min(m, sdseg(q, float2(0.197, 1.552), float2(0.190, 1.450)));
        m = min(m, sdseg(q, float2(0.190, 1.450), float2(0.197, 1.348)));
        m = min(m, sdseg(q, float2(0.197, 1.348), float2(0.217, 1.251)));
        m = min(m, sdseg(q, float2(0.217, 1.251), float2(0.249, 1.162)));
        m = min(m, sdseg(q, float2(0.249, 1.162), float2(0.293, 1.086)));
        m = min(m, sdseg(q, float2(0.293, 1.086), float2(0.345, 1.026)));
        m = min(m, sdseg(q, float2(0.345, 1.026), float2(0.404, 0.984)));
        m = min(m, sdseg(q, float2(0.404, 0.984), float2(0.468, 0.963)));
        m = min(m, sdseg(q, float2(0.468, 0.963), float2(0.532, 0.963)));
        m = min(m, sdseg(q, float2(0.532, 0.963), float2(0.596, 0.984)));
        m = min(m, sdseg(q, float2(0.596, 0.984), float2(0.655, 1.026)));
        m = min(m, sdseg(q, float2(0.655, 1.026), float2(0.707, 1.086)));
        m = min(m, sdseg(q, float2(0.707, 1.086), float2(0.751, 1.162)));
        m = min(m, sdseg(q, float2(0.751, 1.162), float2(0.783, 1.251)));
        m = min(m, sdseg(q, float2(0.783, 1.251), float2(0.803, 1.348)));
        m = min(m, sdseg(q, float2(0.803, 1.348), float2(0.810, 1.450)));
    }
    else if (d > 8.5 && d < 9.5) {
        if (q.x < 0.030 || q.x > 0.970 || q.y < -0.097 || q.y > 2.100) return 0.;
        m = min(m, sdseg(q, float2(0.810, 0.560), float2(0.803, 0.664)));
        m = min(m, sdseg(q, float2(0.803, 0.664), float2(0.783, 0.763)));
        m = min(m, sdseg(q, float2(0.783, 0.763), float2(0.751, 0.854)));
