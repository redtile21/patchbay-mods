// EB Strip slot display: one box on the signal path.
// audioLow: kind / 8 (0 thru, 1 gain, 2 eq, 3 compressor, 4 saturation, 5 limiter), input level, output level (-60..+6 dB), gain reduction / 24 dB
uniform float4 audioLow;
uniform float4 audioMedium;

float sdseg(float2 p, float2 a, float2 b) {
    float2 pa = p - a;
    float2 ba = b - a;
    float h = clamp(dot(pa, ba) / dot(ba, ba), 0., 1.);
    return length(pa - ba * h);
}
// Monoline sans-serif capital in a 1 x 2 box; c is 1 for A to 26 for Z, 0 draws nothing.
float letter(float2 q, float c) {
    if (c < .5) return 0.;
    float m = 10.;
    if (c > 0.5 && c < 1.5) {
        m = min(m, sdseg(q, float2(0.05, 1.95), float2(0.5, 0.05)));
        m = min(m, sdseg(q, float2(0.5, 0.05), float2(0.95, 1.95)));
        m = min(m, sdseg(q, float2(0.25, 1.3), float2(0.75, 1.3)));
    }
    else if (c > 2.5 && c < 3.5) {
        m = min(m, sdseg(q, float2(0.95, 0.45), float2(0.7, 0.08)));
        m = min(m, sdseg(q, float2(0.7, 0.08), float2(0.3, 0.08)));
        m = min(m, sdseg(q, float2(0.3, 0.08), float2(0.05, 0.45)));
        m = min(m, sdseg(q, float2(0.05, 0.45), float2(0.05, 1.55)));
        m = min(m, sdseg(q, float2(0.05, 1.55), float2(0.3, 1.92)));
        m = min(m, sdseg(q, float2(0.3, 1.92), float2(0.7, 1.92)));
        m = min(m, sdseg(q, float2(0.7, 1.92), float2(0.95, 1.55)));
    }
    else if (c > 3.5 && c < 4.5) {
        m = min(m, sdseg(q, float2(0.08, 0.05), float2(0.08, 1.95)));
        m = min(m, sdseg(q, float2(0.08, 1.95), float2(0.55, 1.95)));
        m = min(m, sdseg(q, float2(0.55, 1.95), float2(0.92, 1.5)));
        m = min(m, sdseg(q, float2(0.92, 1.5), float2(0.92, 0.5)));
        m = min(m, sdseg(q, float2(0.92, 0.5), float2(0.55, 0.05)));
        m = min(m, sdseg(q, float2(0.55, 0.05), float2(0.08, 0.05)));
    }
    else if (c > 4.5 && c < 5.5) {
        m = min(m, sdseg(q, float2(0.9, 0.05), float2(0.1, 0.05)));
        m = min(m, sdseg(q, float2(0.1, 0.05), float2(0.1, 1.95)));
        m = min(m, sdseg(q, float2(0.1, 1.95), float2(0.9, 1.95)));
        m = min(m, sdseg(q, float2(0.1, 1.0), float2(0.7, 1.0)));
    }
    else if (c > 6.5 && c < 7.5) {
        m = min(m, sdseg(q, float2(0.95, 0.45), float2(0.7, 0.08)));
        m = min(m, sdseg(q, float2(0.7, 0.08), float2(0.3, 0.08)));
        m = min(m, sdseg(q, float2(0.3, 0.08), float2(0.05, 0.45)));
        m = min(m, sdseg(q, float2(0.05, 0.45), float2(0.05, 1.55)));
        m = min(m, sdseg(q, float2(0.05, 1.55), float2(0.3, 1.92)));
        m = min(m, sdseg(q, float2(0.3, 1.92), float2(0.7, 1.92)));
        m = min(m, sdseg(q, float2(0.7, 1.92), float2(0.95, 1.55)));
        m = min(m, sdseg(q, float2(0.95, 1.55), float2(0.95, 1.05)));
        m = min(m, sdseg(q, float2(0.95, 1.05), float2(0.55, 1.05)));
    }
    else if (c > 7.5 && c < 8.5) {
        m = min(m, sdseg(q, float2(0.1, 0.05), float2(0.1, 1.95)));
        m = min(m, sdseg(q, float2(0.9, 0.05), float2(0.9, 1.95)));
        m = min(m, sdseg(q, float2(0.1, 1.0), float2(0.9, 1.0)));
    }
    else if (c > 8.5 && c < 9.5) {
        m = min(m, sdseg(q, float2(0.5, 0.05), float2(0.5, 1.95)));
        m = min(m, sdseg(q, float2(0.2, 0.05), float2(0.8, 0.05)));
        m = min(m, sdseg(q, float2(0.2, 1.95), float2(0.8, 1.95)));
    }
    else if (c > 10.5 && c < 11.5) {
        m = min(m, sdseg(q, float2(0.1, 0.05), float2(0.1, 1.95)));
        m = min(m, sdseg(q, float2(0.9, 0.05), float2(0.1, 1.1)));
        m = min(m, sdseg(q, float2(0.35, 0.8), float2(0.9, 1.95)));
    }
    else if (c > 11.5 && c < 12.5) {
        m = min(m, sdseg(q, float2(0.1, 0.05), float2(0.1, 1.95)));
        m = min(m, sdseg(q, float2(0.1, 1.95), float2(0.9, 1.95)));
    }
    else if (c > 12.5 && c < 13.5) {
        m = min(m, sdseg(q, float2(0.05, 1.95), float2(0.05, 0.05)));
        m = min(m, sdseg(q, float2(0.05, 0.05), float2(0.5, 1.2)));
        m = min(m, sdseg(q, float2(0.5, 1.2), float2(0.95, 0.05)));
        m = min(m, sdseg(q, float2(0.95, 0.05), float2(0.95, 1.95)));
    }
    else if (c > 13.5 && c < 14.5) {
        m = min(m, sdseg(q, float2(0.1, 1.95), float2(0.1, 0.05)));
        m = min(m, sdseg(q, float2(0.1, 0.05), float2(0.9, 1.95)));
        m = min(m, sdseg(q, float2(0.9, 1.95), float2(0.9, 0.05)));
    }
    else if (c > 14.5 && c < 15.5) {
        m = min(m, sdseg(q, float2(0.3, 0.05), float2(0.7, 0.05)));
        m = min(m, sdseg(q, float2(0.7, 0.05), float2(0.92, 0.4)));
        m = min(m, sdseg(q, float2(0.92, 0.4), float2(0.92, 1.6)));
        m = min(m, sdseg(q, float2(0.92, 1.6), float2(0.7, 1.95)));
        m = min(m, sdseg(q, float2(0.7, 1.95), float2(0.3, 1.95)));
        m = min(m, sdseg(q, float2(0.3, 1.95), float2(0.08, 1.6)));
        m = min(m, sdseg(q, float2(0.08, 1.6), float2(0.08, 0.4)));
        m = min(m, sdseg(q, float2(0.08, 0.4), float2(0.3, 0.05)));
    }
    else if (c > 15.5 && c < 16.5) {
        m = min(m, sdseg(q, float2(0.1, 1.95), float2(0.1, 0.05)));
        m = min(m, sdseg(q, float2(0.1, 0.05), float2(0.7, 0.05)));
        m = min(m, sdseg(q, float2(0.7, 0.05), float2(0.92, 0.35)));
        m = min(m, sdseg(q, float2(0.92, 0.35), float2(0.92, 0.8)));
        m = min(m, sdseg(q, float2(0.92, 0.8), float2(0.7, 1.1)));
        m = min(m, sdseg(q, float2(0.7, 1.1), float2(0.1, 1.1)));
    }
    else if (c > 17.5 && c < 18.5) {
        m = min(m, sdseg(q, float2(0.1, 1.95), float2(0.1, 0.05)));
        m = min(m, sdseg(q, float2(0.1, 0.05), float2(0.7, 0.05)));
        m = min(m, sdseg(q, float2(0.7, 0.05), float2(0.92, 0.35)));
        m = min(m, sdseg(q, float2(0.92, 0.35), float2(0.92, 0.8)));
        m = min(m, sdseg(q, float2(0.92, 0.8), float2(0.7, 1.1)));
        m = min(m, sdseg(q, float2(0.7, 1.1), float2(0.1, 1.1)));
        m = min(m, sdseg(q, float2(0.45, 1.1), float2(0.92, 1.95)));
    }
    else if (c > 18.5 && c < 19.5) {
        m = min(m, sdseg(q, float2(0.9, 0.35), float2(0.7, 0.05)));
        m = min(m, sdseg(q, float2(0.7, 0.05), float2(0.3, 0.05)));
        m = min(m, sdseg(q, float2(0.3, 0.05), float2(0.08, 0.35)));
        m = min(m, sdseg(q, float2(0.08, 0.35), float2(0.1, 0.7)));
        m = min(m, sdseg(q, float2(0.1, 0.7), float2(0.5, 1.0)));
        m = min(m, sdseg(q, float2(0.5, 1.0), float2(0.9, 1.3)));
        m = min(m, sdseg(q, float2(0.9, 1.3), float2(0.92, 1.65)));
        m = min(m, sdseg(q, float2(0.92, 1.65), float2(0.7, 1.95)));
        m = min(m, sdseg(q, float2(0.7, 1.95), float2(0.3, 1.95)));
        m = min(m, sdseg(q, float2(0.3, 1.95), float2(0.08, 1.65)));
    }
    else if (c > 19.5 && c < 20.5) {
        m = min(m, sdseg(q, float2(0.05, 0.05), float2(0.95, 0.05)));
        m = min(m, sdseg(q, float2(0.5, 0.05), float2(0.5, 1.95)));
    }
    else if (c > 20.5 && c < 21.5) {
        m = min(m, sdseg(q, float2(0.1, 0.05), float2(0.1, 1.55)));
        m = min(m, sdseg(q, float2(0.1, 1.55), float2(0.3, 1.95)));
        m = min(m, sdseg(q, float2(0.3, 1.95), float2(0.7, 1.95)));
        m = min(m, sdseg(q, float2(0.7, 1.95), float2(0.9, 1.55)));
        m = min(m, sdseg(q, float2(0.9, 1.55), float2(0.9, 0.05)));
    }
    else if (c > 21.5 && c < 22.5) {
        m = min(m, sdseg(q, float2(0.05, 0.05), float2(0.5, 1.95)));
        m = min(m, sdseg(q, float2(0.5, 1.95), float2(0.95, 0.05)));
    }
    else if (c > 22.5 && c < 23.5) {
        m = min(m, sdseg(q, float2(0.03, 0.05), float2(0.25, 1.95)));
        m = min(m, sdseg(q, float2(0.25, 1.95), float2(0.5, 0.8)));
        m = min(m, sdseg(q, float2(0.5, 0.8), float2(0.75, 1.95)));
        m = min(m, sdseg(q, float2(0.75, 1.95), float2(0.97, 0.05)));
    }
    else if (c > 23.5 && c < 24.5) {
        m = min(m, sdseg(q, float2(0.1, 0.05), float2(0.9, 1.95)));
        m = min(m, sdseg(q, float2(0.9, 0.05), float2(0.1, 1.95)));
    }
    else if (c > 24.5 && c < 25.5) {
        m = min(m, sdseg(q, float2(0.05, 0.05), float2(0.5, 1.0)));
        m = min(m, sdseg(q, float2(0.5, 1.0), float2(0.95, 0.05)));
        m = min(m, sdseg(q, float2(0.5, 1.0), float2(0.5, 1.95)));
    }
    return 1. - smoothstep(.10, .20, m);
}

// A word of up to six letters centred on x; the baseline origin is the top-left of the first glyph.
float word(float2 p, float cx, float y, float h, float a, float b, float c, float d, float e, float f) {
    float w = h * .5;
    float adv = w * 1.3;
    float n = 0.;
    if (a > .5) n += 1.;
    if (b > .5) n += 1.;
    if (c > .5) n += 1.;
    if (d > .5) n += 1.;
    if (e > .5) n += 1.;
    if (f > .5) n += 1.;
    float x0 = cx - n * adv * .5;
    float2 s = p - float2(x0, y - h);
    float lit = 0.;
    lit = max(lit, letter(s / w, a));
    lit = max(lit, letter((s - float2(adv, 0.)) / w, b));
    lit = max(lit, letter((s - float2(2. * adv, 0.)) / w, c));
    lit = max(lit, letter((s - float2(3. * adv, 0.)) / w, d));
    lit = max(lit, letter((s - float2(4. * adv, 0.)) / w, e));
    lit = max(lit, letter((s - float2(5. * adv, 0.)) / w, f));
    return lit;
}


void put(inout float3 col, inout float a, float3 c, float ca) {
    float na = ca + a * (1. - ca);
    if (na > .001) col = (c * ca + col * a * (1. - ca)) / na;
    a = na;
}
float box(float2 p, float2 lo, float2 hi) {
    return (p.x >= lo.x && p.x <= hi.x && p.y >= lo.y && p.y <= hi.y) ? 1. : 0.;
}

half4 main(float2 fragCoord) {
    // 19 x 8 grid units -> 152 x 64 design units.
    float2 p = fragCoord / iResolution.xy * float2(152., 64.);
    float kind = floor(audioLow.x * 8. + .5);
    float inlv = audioLow.y;
    float outlv = audioLow.z;
    float gr = audioLow.w;
    float3 col = float3(0.);
    float a = 0.;
    float3 blue = float3(.33, .60, .96);   // the units' accent
    float3 red = float3(.95, .42, .26);
    float3 dim = float3(.21, .24, .28);
    float3 track = float3(.030, .036, .043); // meter wells, as the units'
    float3 face = float3(.060, .070, .082);  // panel face, as the units'
    float3 text = float3(.82, .86, .90);     // as the units'
    bool thru = kind < .5;
    float3 sig = thru ? dim : blue;

    // Signal path in and out of the box, brighter with level.
    float lineY = abs(p.y - 32.);
    float inLine = (p.x < 16.) ? (1. - smoothstep(.9, 1.6, lineY)) : 0.;
    float outLine = (p.x > 136.) ? (1. - smoothstep(.9, 1.6, lineY)) : 0.;
    put(col, a, dim, inLine * .7);
    put(col, a, dim, outLine * .7);
    put(col, a, sig, inLine * clamp(inlv * 1.3, 0., 1.));
    put(col, a, sig, outLine * clamp(outlv * 1.3, 0., 1.));
    // Arrow head on the right.
    float ax = 152. - p.x;
    if (ax > 0. && ax < 7. && abs(p.y - 32.) < ax * .6) put(col, a, thru ? dim : sig, .85);

    // The box.
    float inside = box(p, float2(16., 8.), float2(136., 56.));
    float edge = inside * (1. - box(p, float2(17.2, 9.2), float2(134.8, 54.8)));
    put(col, a, face, inside * .92);
    put(col, a, thru ? dim : blue * .75, edge * .9);

    // Level bars along the bottom of the box: input (dim) over output (bright).
    if (!thru) {
        float bx = (p.x - 24.) / 104.;
        if (p.y > 44. && p.y < 47. && bx > 0. && bx < 1.) put(col, a, track, 1.);
        if (p.y > 44. && p.y < 47. && bx > 0. && bx < inlv) put(col, a, blue * .45, 1.);
        if (p.y > 49. && p.y < 52. && bx > 0. && bx < 1.) put(col, a, track, 1.);
        if (p.y > 49. && p.y < 52. && bx > 0. && bx < outlv) put(col, a, mix(float3(.24, .62, .17), float3(.96, .56, .12), smoothstep(.55, 1., bx)) * (bx > .91 ? 0. : 1.) + (bx > .91 ? float3(.92, .30, .22) : float3(0.)), 1.);
        // Gain reduction hangs from the top.
        if (p.y > 11. && p.y < 14. && bx > 0. && bx < 1.) put(col, a, track, kind > 2.5 ? 1. : 0.);
        if (p.y > 11. && p.y < 14. && bx > 0. && bx < gr && (kind > 2.5 && (kind < 3.5 || kind > 4.5))) put(col, a, red, 1.);
    }

    // The unit's name.
    float lit = 0.;
    float h = 15.;
    float cx = 76.;
    float ly = 36.;
    if (kind < .5) lit = word(p, cx, ly, h, 20., 8., 18., 21., 0., 0.);                       // THRU
    else if (kind < 1.5) lit = word(p, cx, ly, h, 7., 1., 9., 14., 0., 0.);                   // GAIN
    else if (kind < 2.5) {                                                                      // EQ
        float2 s = p - float2(cx - 14., ly - h);
        float w = h * .5;
        lit = max(letter(s / w, 5.), letter((s - float2(w * 1.5, 0.)) / w, 15.));
        float2 q = (s - float2(w * 1.5, 0.)) / w;
        lit = max(lit, 1. - smoothstep(.10, .20, sdseg(q, float2(.6, 1.5), float2(1., 2.05))));
    }
    else if (kind < 3.5) lit = word(p, cx, ly, h, 3., 15., 13., 16., 0., 0.);                 // COMP
    else if (kind < 4.5) lit = word(p, cx, ly, h, 19., 1., 20., 0., 0., 0.);                  // SAT
    else lit = word(p, cx, ly, h, 12., 9., 13., 9., 20., 0.);                                  // LIMIT
    put(col, a, thru ? dim : text, lit);
    return half4(half3(col * a), half(a));
}
