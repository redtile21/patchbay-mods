// Mini display for one strip slot.
// audioLow:    kind / 8 (0 bypass, 1 gain, 2 eq, 3 compressor, 4 saturation, 5 limiter), input level, output level (-60..+6 dB), aux
//              (compressor gain reduction / 24 dB, limiter gain reduction / 12 dB)
// audioMedium: the three macro knobs / 100
uniform float4 audioLow;
uniform float4 audioMedium;

float sdseg(float2 p, float2 a, float2 b) {
    float2 pa = p - a;
    float2 ba = b - a;
    float h = clamp(dot(pa, ba) / dot(ba, ba), 0., 1.);
    return length(pa - ba * h);
}
// Monoline sans-serif capital in a 1 x 2 box; c is 1 for A to 26 for Z, 0 draws nothing.
float letter(float2 q, float c) {
    if (c < .5) return 0.;
    float m = 10.;
    if (c > 0.5 && c < 1.5) {
        m = min(m, sdseg(q, float2(0.05, 1.95), float2(0.5, 0.05)));
        m = min(m, sdseg(q, float2(0.5, 0.05), float2(0.95, 1.95)));
        m = min(m, sdseg(q, float2(0.25, 1.3), float2(0.75, 1.3)));
    }
    else if (c > 2.5 && c < 3.5) {
        m = min(m, sdseg(q, float2(0.95, 0.45), float2(0.7, 0.08)));
        m = min(m, sdseg(q, float2(0.7, 0.08), float2(0.3, 0.08)));
        m = min(m, sdseg(q, float2(0.3, 0.08), float2(0.05, 0.45)));
        m = min(m, sdseg(q, float2(0.05, 0.45), float2(0.05, 1.55)));
        m = min(m, sdseg(q, float2(0.05, 1.55), float2(0.3, 1.92)));
        m = min(m, sdseg(q, float2(0.3, 1.92), float2(0.7, 1.92)));
        m = min(m, sdseg(q, float2(0.7, 1.92), float2(0.95, 1.55)));
    }
    else if (c > 3.5 && c < 4.5) {
        m = min(m, sdseg(q, float2(0.08, 0.05), float2(0.08, 1.95)));
        m = min(m, sdseg(q, float2(0.08, 1.95), float2(0.55, 1.95)));
        m = min(m, sdseg(q, float2(0.55, 1.95), float2(0.92, 1.5)));
        m = min(m, sdseg(q, float2(0.92, 1.5), float2(0.92, 0.5)));
        m = min(m, sdseg(q, float2(0.92, 0.5), float2(0.55, 0.05)));
        m = min(m, sdseg(q, float2(0.55, 0.05), float2(0.08, 0.05)));
    }
    else if (c > 4.5 && c < 5.5) {
        m = min(m, sdseg(q, float2(0.9, 0.05), float2(0.1, 0.05)));
        m = min(m, sdseg(q, float2(0.1, 0.05), float2(0.1, 1.95)));
        m = min(m, sdseg(q, float2(0.1, 1.95), float2(0.9, 1.95)));
        m = min(m, sdseg(q, float2(0.1, 1.0), float2(0.7, 1.0)));
    }
    else if (c > 6.5 && c < 7.5) {
        m = min(m, sdseg(q, float2(0.95, 0.45), float2(0.7, 0.08)));
        m = min(m, sdseg(q, float2(0.7, 0.08), float2(0.3, 0.08)));
        m = min(m, sdseg(q, float2(0.3, 0.08), float2(0.05, 0.45)));
        m = min(m, sdseg(q, float2(0.05, 0.45), float2(0.05, 1.55)));
        m = min(m, sdseg(q, float2(0.05, 1.55), float2(0.3, 1.92)));
        m = min(m, sdseg(q, float2(0.3, 1.92), float2(0.7, 1.92)));
        m = min(m, sdseg(q, float2(0.7, 1.92), float2(0.95, 1.55)));
        m = min(m, sdseg(q, float2(0.95, 1.55), float2(0.95, 1.05)));
        m = min(m, sdseg(q, float2(0.95, 1.05), float2(0.55, 1.05)));
    }
    else if (c > 7.5 && c < 8.5) {
        m = min(m, sdseg(q, float2(0.1, 0.05), float2(0.1, 1.95)));
        m = min(m, sdseg(q, float2(0.9, 0.05), float2(0.9, 1.95)));
        m = min(m, sdseg(q, float2(0.1, 1.0), float2(0.9, 1.0)));
    }
    else if (c > 8.5 && c < 9.5) {
        m = min(m, sdseg(q, float2(0.5, 0.05), float2(0.5, 1.95)));
        m = min(m, sdseg(q, float2(0.2, 0.05), float2(0.8, 0.05)));
        m = min(m, sdseg(q, float2(0.2, 1.95), float2(0.8, 1.95)));
    }
    else if (c > 10.5 && c < 11.5) {
        m = min(m, sdseg(q, float2(0.1, 0.05), float2(0.1, 1.95)));
        m = min(m, sdseg(q, float2(0.9, 0.05), float2(0.1, 1.1)));
        m = min(m, sdseg(q, float2(0.35, 0.8), float2(0.9, 1.95)));
    }
    else if (c > 11.5 && c < 12.5) {
        m = min(m, sdseg(q, float2(0.1, 0.05), float2(0.1, 1.95)));
        m = min(m, sdseg(q, float2(0.1, 1.95), float2(0.9, 1.95)));
    }
    else if (c > 12.5 && c < 13.5) {
        m = min(m, sdseg(q, float2(0.05, 1.95), float2(0.05, 0.05)));
        m = min(m, sdseg(q, float2(0.05, 0.05), float2(0.5, 1.2)));
        m = min(m, sdseg(q, float2(0.5, 1.2), float2(0.95, 0.05)));
        m = min(m, sdseg(q, float2(0.95, 0.05), float2(0.95, 1.95)));
    }
    else if (c > 13.5 && c < 14.5) {
        m = min(m, sdseg(q, float2(0.1, 1.95), float2(0.1, 0.05)));
        m = min(m, sdseg(q, float2(0.1, 0.05), float2(0.9, 1.95)));
        m = min(m, sdseg(q, float2(0.9, 1.95), float2(0.9, 0.05)));
    }
    else if (c > 14.5 && c < 15.5) {
        m = min(m, sdseg(q, float2(0.3, 0.05), float2(0.7, 0.05)));
        m = min(m, sdseg(q, float2(0.7, 0.05), float2(0.92, 0.4)));
        m = min(m, sdseg(q, float2(0.92, 0.4), float2(0.92, 1.6)));
        m = min(m, sdseg(q, float2(0.92, 1.6), float2(0.7, 1.95)));
        m = min(m, sdseg(q, float2(0.7, 1.95), float2(0.3, 1.95)));
        m = min(m, sdseg(q, float2(0.3, 1.95), float2(0.08, 1.6)));
        m = min(m, sdseg(q, float2(0.08, 1.6), float2(0.08, 0.4)));
        m = min(m, sdseg(q, float2(0.08, 0.4), float2(0.3, 0.05)));
    }
    else if (c > 15.5 && c < 16.5) {
        m = min(m, sdseg(q, float2(0.1, 1.95), float2(0.1, 0.05)));
        m = min(m, sdseg(q, float2(0.1, 0.05), float2(0.7, 0.05)));
        m = min(m, sdseg(q, float2(0.7, 0.05), float2(0.92, 0.35)));
        m = min(m, sdseg(q, float2(0.92, 0.35), float2(0.92, 0.8)));
        m = min(m, sdseg(q, float2(0.92, 0.8), float2(0.7, 1.1)));
        m = min(m, sdseg(q, float2(0.7, 1.1), float2(0.1, 1.1)));
    }
    else if (c > 17.5 && c < 18.5) {
        m = min(m, sdseg(q, float2(0.1, 1.95), float2(0.1, 0.05)));
        m = min(m, sdseg(q, float2(0.1, 0.05), float2(0.7, 0.05)));
        m = min(m, sdseg(q, float2(0.7, 0.05), float2(0.92, 0.35)));
        m = min(m, sdseg(q, float2(0.92, 0.35), float2(0.92, 0.8)));
        m = min(m, sdseg(q, float2(0.92, 0.8), float2(0.7, 1.1)));
        m = min(m, sdseg(q, float2(0.7, 1.1), float2(0.1, 1.1)));
        m = min(m, sdseg(q, float2(0.45, 1.1), float2(0.92, 1.95)));
    }
    else if (c > 18.5 && c < 19.5) {
        m = min(m, sdseg(q, float2(0.9, 0.35), float2(0.7, 0.05)));
        m = min(m, sdseg(q, float2(0.7, 0.05), float2(0.3, 0.05)));
        m = min(m, sdseg(q, float2(0.3, 0.05), float2(0.08, 0.35)));
        m = min(m, sdseg(q, float2(0.08, 0.35), float2(0.1, 0.7)));
        m = min(m, sdseg(q, float2(0.1, 0.7), float2(0.5, 1.0)));
        m = min(m, sdseg(q, float2(0.5, 1.0), float2(0.9, 1.3)));
        m = min(m, sdseg(q, float2(0.9, 1.3), float2(0.92, 1.65)));
        m = min(m, sdseg(q, float2(0.92, 1.65), float2(0.7, 1.95)));
        m = min(m, sdseg(q, float2(0.7, 1.95), float2(0.3, 1.95)));
        m = min(m, sdseg(q, float2(0.3, 1.95), float2(0.08, 1.65)));
    }
    else if (c > 19.5 && c < 20.5) {
        m = min(m, sdseg(q, float2(0.05, 0.05), float2(0.95, 0.05)));
        m = min(m, sdseg(q, float2(0.5, 0.05), float2(0.5, 1.95)));
    }
    else if (c > 20.5 && c < 21.5) {
        m = min(m, sdseg(q, float2(0.1, 0.05), float2(0.1, 1.55)));
        m = min(m, sdseg(q, float2(0.1, 1.55), float2(0.3, 1.95)));
        m = min(m, sdseg(q, float2(0.3, 1.95), float2(0.7, 1.95)));
        m = min(m, sdseg(q, float2(0.7, 1.95), float2(0.9, 1.55)));
        m = min(m, sdseg(q, float2(0.9, 1.55), float2(0.9, 0.05)));
    }
    else if (c > 21.5 && c < 22.5) {
        m = min(m, sdseg(q, float2(0.05, 0.05), float2(0.5, 1.95)));
        m = min(m, sdseg(q, float2(0.5, 1.95), float2(0.95, 0.05)));
    }
    else if (c > 22.5 && c < 23.5) {
        m = min(m, sdseg(q, float2(0.03, 0.05), float2(0.25, 1.95)));
        m = min(m, sdseg(q, float2(0.25, 1.95), float2(0.5, 0.8)));
        m = min(m, sdseg(q, float2(0.5, 0.8), float2(0.75, 1.95)));
        m = min(m, sdseg(q, float2(0.75, 1.95), float2(0.97, 0.05)));
    }
    else if (c > 23.5 && c < 24.5) {
        m = min(m, sdseg(q, float2(0.1, 0.05), float2(0.9, 1.95)));
        m = min(m, sdseg(q, float2(0.9, 0.05), float2(0.1, 1.95)));
    }
    else if (c > 24.5 && c < 25.5) {
        m = min(m, sdseg(q, float2(0.05, 0.05), float2(0.5, 1.0)));
        m = min(m, sdseg(q, float2(0.5, 1.0), float2(0.95, 0.05)));
        m = min(m, sdseg(q, float2(0.5, 1.0), float2(0.5, 1.95)));
    }
    return 1. - smoothstep(.10, .20, m);
}

// A word of up to six letters centred on x; the baseline origin is the top-left of the first glyph.
float word(float2 p, float cx, float y, float h, float a, float b, float c, float d, float e, float f) {
    float w = h * .5;
    float adv = w * 1.3;
    float n = 0.;
    if (a > .5) n += 1.;
    if (b > .5) n += 1.;
    if (c > .5) n += 1.;
    if (d > .5) n += 1.;
    if (e > .5) n += 1.;
    if (f > .5) n += 1.;
    float x0 = cx - n * adv * .5;
    float2 s = p - float2(x0, y - h);
    float lit = 0.;
    lit = max(lit, letter(s / w, a));
    lit = max(lit, letter((s - float2(adv, 0.)) / w, b));
    lit = max(lit, letter((s - float2(2. * adv, 0.)) / w, c));
    lit = max(lit, letter((s - float2(3. * adv, 0.)) / w, d));
    lit = max(lit, letter((s - float2(4. * adv, 0.)) / w, e));
    lit = max(lit, letter((s - float2(5. * adv, 0.)) / w, f));
    return lit;
}

float xr(float tw, float f0) {
    return tw / tan(3.1415927 * clamp(f0, 10., 22000.) / 48000.);
}
float peakdb(float g, float f, float q, float tw) {
    float x = xr(tw, f);
    float x2 = x * x;
    float A = pow(10., g / 40.);
    float qq = max(q, .1);
    float u = (1. - x2) * (1. - x2);
    return 10. * log((u + x2 * A * A / (qq * qq)) / (u + x2 / (A * A * qq * qq))) / 2.302585;
}
float shelfdb(float g, float f, float q, float tw, bool low) {
    float x = xr(tw, f);
    float x2 = x * x;
    float A = pow(10., g / 40.);
    float k2 = A / (q * q);
    float n; float d;
    if (low) {
        n = (A - x2) * (A - x2) + x2 * k2;
        d = (1. - A * x2) * (1. - A * x2) + x2 * k2;
    } else {
        n = (1. - A * x2) * (1. - A * x2) + x2 * k2;
        d = (A - x2) * (A - x2) + x2 * k2;
    }
    return 10. * log(A * A * n / d) / 2.302585;
}
float tanhf(float v) {
    float e = exp(2. * clamp(v, -12., 12.));
    return (e - 1.) / (e + 1.);
}
float shape(float v, float kd) {
    if (kd < .5) return tanhf(v);
    if (kd < 1.5) return v >= 0. ? tanhf(v) : tanhf(v * .7) / .7;
    if (kd < 2.5) {
        float c = clamp(v, -1., 1.);
        return 1.5 * c - .5 * c * c * c;
    }
    return clamp(v, -1., 1.);
}
float curvec(float x, float t, float r, float w) {
    float over = x - t;
    float y = x;
    if (2. * over > w) {
        y = t + over / r;
    } else if (2. * over > -w) {
        float k = over + w * .5;
        y = x + (1. / r - 1.) * k * k / (2. * max(w, .0001));
    }
    return y;
}
// Source-over compositing of colour c with alpha ca onto (col, a); col is not premultiplied.
void put(inout float3 col, inout float a, float3 c, float ca) {
    float na = ca + a * (1. - ca);
    if (na > .001) col = (c * ca + col * a * (1. - ca)) / na;
    a = na;
}

half4 main(float2 fragCoord) {
    // 44 x 30 grid units -> 176 x 120 design units. The top 96 are the display, the rest holds the knob labels.
    float2 p = fragCoord / iResolution.xy * float2(176., 120.);
    float kind = floor(audioLow.x * 8. + .5);
    float inlv = audioLow.y;
    float outlv = audioLow.z;
    float aux = audioLow.w;
    float k1 = audioMedium.x * 100.;
    float k2 = audioMedium.y * 100.;
    float k3 = audioMedium.z * 100.;
    float3 col = float3(0.);
    float a = 0.;
    float3 blue = float3(.50, .76, 1.);
    float3 red = float3(.95, .42, .26);
    float3 bg = float3(.035, .042, .052);
    float3 gridc = float3(.14, .16, .19);

    if (p.y < 97.) {
        if (kind > .5 && kind < 1.5) {
            // Gain: pan marker, width bar, output level.
            put(col, a, bg, .55);
            float pan = (k2 - 50.) * 2.;
            float wd = k3 * .02;
            if (p.x >= 12. && p.x <= 140. && abs(p.y - 36.) < 3.) put(col, a, float3(.2, .23, .26), 1.);
            if (abs(p.x - (12. + (pan + 100.) / 200. * 128.)) < 2. && abs(p.y - 36.) < 8.) put(col, a, blue, 1.);
            if (p.x >= 12. && p.x <= 140. && abs(p.y - 62.) < 3.) put(col, a, float3(.2, .23, .26), 1.);
            if (p.x >= 12. && p.x <= 12. + wd * .5 * 128. && abs(p.y - 62.) < 3.) put(col, a, float3(.36, .66, .59), 1.);
            if (abs(p.x - 76.) < 1. && abs(p.y - 62.) < 8.) put(col, a, float3(.8, .85, .9), 1.);
            if (p.x >= 154. && p.x <= 168. && p.y >= 8. && p.y <= 90.) {
                float lv = (90. - p.y) / 82.;
                put(col, a, float3(.07, .08, .095), 1.);
                if (lv < outlv) put(col, a, mix(float3(.24, .62, .17), float3(.96, .56, .12), smoothstep(.55, .85, lv)), 1.);
            }
        }
        if (kind > 1.5 && kind < 2.5) {
            // Equaliser: response curve over the spectrum.
            float note = 15. + p.x / 176. * 120.;
            float f = 440. * pow(2., (note - 69.) / 12.);
            float w = tan(3.1415927 * f / 48000.);
            float total = shelfdb((k1 - 50.) * .3, 100., .7071, w, true) + peakdb((k2 - 50.) * .3, 1200., .9, w)
                        + shelfdb((k3 - 50.) * .3, 8000., .7071, w, false);
            total = clamp(total, -40., 16.);
            float cy = (18. - total) / 60. * 96.;
            float zy = 18. / 60. * 96.;
            put(col, a, float3(.8, .85, .9), abs(p.y - zy) < .7 ? .25 : 0.);
            if (p.y >= min(cy, zy) && p.y <= max(cy, zy)) put(col, a, float3(1., .86, .45), .16);
            float dist = abs(p.y - cy);
            put(col, a, float3(1., .86, .45), dist < 1.4 ? 1. : (dist < 2.4 ? 2.4 - dist : 0.));
        }
        if (kind > 2.5 && kind < 3.5) {
            // Compressor: transfer curve, live level dot and gain reduction bar.
            put(col, a, bg, .62);
            float thr = -48. + k1 * .48;
            float rn = k2 * .01;
            float ratio = 1. + 19. * rn * rn;
            float mk = k3 * .08;
            if (p.x >= 10. && p.x <= 148. && p.y >= 8. && p.y <= 90.) {
                float gx = (p.x - 10.) / 138.;
                float gy = (90. - p.y) / 82.;
                for (int i = 1; i < 6; i++) {
                    if (abs(gx - float(i) / 6.) < .004 || abs(gy - float(i) / 6.) < .007) put(col, a, gridc, 1.);
                }
                float xdb = -60. + gx * 60.;
                float yc = (curvec(xdb, thr, ratio, 6.) + mk + 60.) / 72.;
                if (abs(gx - (thr + 60.) / 60.) < .004) put(col, a, blue * .55, 1.);
                if (gy < yc) put(col, a, float3(.1, .2, .32), .45);
                if (abs(gy - yc) < .016) put(col, a, blue, 1.);
                float idb = inlv * 66. - 60.;
                float ix = (idb + 60.) / 60.;
                float iy = (curvec(idb, thr, ratio, 6.) + mk + 60.) / 72.;
                if (length(float2((gx - ix) * 138., (gy - iy) * 82.)) < 3.4) put(col, a, aux > .02 ? red : float3(.95, .96, .98), 1.);
            }
            if (p.x >= 154. && p.x <= 166. && p.y >= 8. && p.y <= 90.) {
                put(col, a, float3(.07, .08, .095), 1.);
                if ((p.y - 8.) / 82. < aux) put(col, a, red, 1.);
            }
        }
        if (kind > 3.5 && kind < 4.5) {
            // Saturation: transfer curve with the live operating point.
            put(col, a, bg, .62);
            float dr = k1 * .2;
            float drive = pow(10., dr / 20.);
            float ty = floor(clamp(k2, 0., 99.9) * .04);
            float m = k3 * .01;
            float ol = pow(10., -dr * .6 / 20.);
            if (p.x >= 34. && p.x <= 126. && p.y >= 8. && p.y <= 90.) {
                float gx = (p.x - 34.) / 92. * 2. - 1.;
                float gy = 1. - (p.y - 8.) / 82. * 2.;
                if (abs(gx) < .01 || abs(gy) < .012) put(col, a, gridc, 1.);
                float yc = (gx * (1. - m) + shape(gx * drive, ty) * m) * ol;
                yc = clamp(yc, -1.2, 1.2);
                if (abs(gy - yc) < .045) put(col, a, blue, 1.);
                float il = pow(10., (inlv * 66. - 60.) / 20.);
                float iy = clamp((il * (1. - m) + shape(il * drive, ty) * m) * ol, -1.2, 1.2);
                if (length(float2((gx - il) * 46., (gy - iy) * 41.)) < 3.2) put(col, a, float3(.95, .96, .98), 1.);
            }
        }
        if (kind > 4.5 && kind < 5.5) {
            // Limiter: transfer curve clipped at the ceiling, live dot and gain reduction bar.
            put(col, a, bg, .62);
            float cn = 1. - k2 * .01;
            float cdb = -12. * cn * cn;
            float c = (cdb + 30.) / 36.;
            if (p.x >= 10. && p.x <= 148. && p.y >= 8. && p.y <= 90.) {
                float gx = (p.x - 10.) / 138.;
                float gy = (90. - p.y) / 82.;
                for (int i = 1; i < 6; i++) {
                    if (abs(gx - float(i) / 6.) < .004 || abs(gy - float(i) / 6.) < .007) put(col, a, gridc, 1.);
                }
                float yc = min(gx, c);
                if (abs(gx - c) < .004) put(col, a, blue * .55, 1.);
                if (gy < yc) put(col, a, float3(.1, .2, .32), .45);
                if (abs(gy - c) < .008) put(col, a, blue * .8, 1.);
                if (abs(gy - yc) < .016) put(col, a, blue, 1.);
                float ix = clamp((inlv * 66. - 60. + k1 * .12 + 30.) / 36., 0., 1.);
                if (length(float2((gx - ix) * 138., (gy - min(ix, c)) * 82.)) < 3.4) put(col, a, aux > .02 ? red : float3(.95, .96, .98), 1.);
            }
            if (p.x >= 154. && p.x <= 166. && p.y >= 8. && p.y <= 90.) {
                put(col, a, float3(.07, .08, .095), 1.);
                if ((p.y - 8.) / 82. < aux) put(col, a, red, 1.);
            }
        }
    } else if (kind > .5) {
        float lit = 0.;
        if (kind > 0.5 && kind < 1.5) {
            lit = max(lit, word(p, 32., 109., 8., 7.0, 1.0, 9.0, 14.0, 0., 0.));
            lit = max(lit, word(p, 88., 109., 8., 16.0, 1.0, 14.0, 0., 0., 0.));
            lit = max(lit, word(p, 144., 109., 8., 23.0, 9.0, 4.0, 20.0, 8.0, 0.));
        }
        if (kind > 1.5 && kind < 2.5) {
            lit = max(lit, word(p, 32., 109., 8., 12.0, 15.0, 23.0, 0., 0., 0.));
            lit = max(lit, word(p, 88., 109., 8., 13.0, 9.0, 4.0, 0., 0., 0.));
            lit = max(lit, word(p, 144., 109., 8., 8.0, 9.0, 7.0, 8.0, 0., 0.));
        }
        if (kind > 2.5 && kind < 3.5) {
            lit = max(lit, word(p, 32., 109., 8., 20.0, 8.0, 18.0, 5.0, 19.0, 8.0));
            lit = max(lit, word(p, 88., 109., 8., 18.0, 1.0, 20.0, 9.0, 15.0, 0.));
            lit = max(lit, word(p, 144., 109., 8., 13.0, 1.0, 11.0, 5.0, 21.0, 16.0));
        }
        if (kind > 3.5 && kind < 4.5) {
            lit = max(lit, word(p, 32., 109., 8., 4.0, 18.0, 9.0, 22.0, 5.0, 0.));
            lit = max(lit, word(p, 88., 109., 8., 20.0, 25.0, 16.0, 5.0, 0., 0.));
            lit = max(lit, word(p, 144., 109., 8., 13.0, 9.0, 24.0, 0., 0., 0.));
        }
        if (kind > 4.5 && kind < 5.5) {
            lit = max(lit, word(p, 32., 109., 8., 9.0, 14.0, 16.0, 21.0, 20.0, 0.));
            lit = max(lit, word(p, 88., 109., 8., 3.0, 5.0, 9.0, 12.0, 0., 0.));
            lit = max(lit, word(p, 144., 109., 8., 18.0, 5.0, 12.0, 0., 0., 0.));
        }
        put(col, a, float3(.82, .86, .90), lit);
    }
    return half4(half3(col * a), half(a));
}
