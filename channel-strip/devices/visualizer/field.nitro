component eb_vis_field
{
    audio_inport in;

    audio_outport out;
    audio_outport f32<4> display;
    audio_outport f32<4> display2;
    f32 p_sr = 0.0;
    f32 e_lr = 0.0;
    f32 e_ll = 0.0;
    f32 e_rr = 0.0;
    f32 b0_0 = 0.0;
    f32 b2_0 = 0.0;
    f32 a1_0 = 0.0;
    f32 a2_0 = 0.0;
    f32 ex0 = 0.0;
    f32 x1l0 = 0.0;
    f32 x2l0 = 0.0;
    f32 y1l0 = 0.0;
    f32 y2l0 = 0.0;
    f32 el0 = 0.0;
    f32 x1r0 = 0.0;
    f32 x2r0 = 0.0;
    f32 y1r0 = 0.0;
    f32 y2r0 = 0.0;
    f32 er0 = 0.0;
    f32 b0_1 = 0.0;
    f32 b2_1 = 0.0;
    f32 a1_1 = 0.0;
    f32 a2_1 = 0.0;
    f32 ex1 = 0.0;
    f32 x1l1 = 0.0;
    f32 x2l1 = 0.0;
    f32 y1l1 = 0.0;
    f32 y2l1 = 0.0;
    f32 el1 = 0.0;
    f32 x1r1 = 0.0;
    f32 x2r1 = 0.0;
    f32 y1r1 = 0.0;
    f32 y2r1 = 0.0;
    f32 er1 = 0.0;
    f32 b0_2 = 0.0;
    f32 b2_2 = 0.0;
    f32 a1_2 = 0.0;
    f32 a2_2 = 0.0;
    f32 ex2 = 0.0;
    f32 x1l2 = 0.0;
    f32 x2l2 = 0.0;
    f32 y1l2 = 0.0;
    f32 y2l2 = 0.0;
    f32 el2 = 0.0;
    f32 x1r2 = 0.0;
    f32 x2r2 = 0.0;
    f32 y1r2 = 0.0;
    f32 y2r2 = 0.0;
    f32 er2 = 0.0;
    f32 b0_3 = 0.0;
    f32 b2_3 = 0.0;
    f32 a1_3 = 0.0;
    f32 a2_3 = 0.0;
    f32 ex3 = 0.0;
    f32 x1l3 = 0.0;
    f32 x2l3 = 0.0;
    f32 y1l3 = 0.0;
    f32 y2l3 = 0.0;
    f32 el3 = 0.0;
    f32 x1r3 = 0.0;
    f32 x2r3 = 0.0;
    f32 y1r3 = 0.0;
    f32 y2r3 = 0.0;
    f32 er3 = 0.0;
    f32 b0_4 = 0.0;
    f32 b2_4 = 0.0;
    f32 a1_4 = 0.0;
    f32 a2_4 = 0.0;
    f32 ex4 = 0.0;
    f32 x1l4 = 0.0;
    f32 x2l4 = 0.0;
    f32 y1l4 = 0.0;
    f32 y2l4 = 0.0;
    f32 el4 = 0.0;
    f32 x1r4 = 0.0;
    f32 x2r4 = 0.0;
    f32 y1r4 = 0.0;
    f32 y2r4 = 0.0;
    f32 er4 = 0.0;
    f32 b0_5 = 0.0;
    f32 b2_5 = 0.0;
    f32 a1_5 = 0.0;
    f32 a2_5 = 0.0;
    f32 ex5 = 0.0;
    f32 x1l5 = 0.0;
    f32 x2l5 = 0.0;
    f32 y1l5 = 0.0;
    f32 y2l5 = 0.0;
    f32 el5 = 0.0;
    f32 x1r5 = 0.0;
    f32 x2r5 = 0.0;
    f32 y1r5 = 0.0;
    f32 y2r5 = 0.0;
    f32 er5 = 0.0;
    f32 b0_6 = 0.0;
    f32 b2_6 = 0.0;
    f32 a1_6 = 0.0;
    f32 a2_6 = 0.0;
    f32 ex6 = 0.0;
    f32 x1l6 = 0.0;
    f32 x2l6 = 0.0;
    f32 y1l6 = 0.0;
    f32 y2l6 = 0.0;
    f32 el6 = 0.0;
    f32 x1r6 = 0.0;
    f32 x2r6 = 0.0;
    f32 y1r6 = 0.0;
    f32 y2r6 = 0.0;
    f32 er6 = 0.0;
    f32 b0_7 = 0.0;
    f32 b2_7 = 0.0;
    f32 a1_7 = 0.0;
    f32 a2_7 = 0.0;
    f32 ex7 = 0.0;
    f32 x1l7 = 0.0;
    f32 x2l7 = 0.0;
    f32 y1l7 = 0.0;
    f32 y2l7 = 0.0;
    f32 el7 = 0.0;
    f32 x1r7 = 0.0;
    f32 x2r7 = 0.0;
    f32 y1r7 = 0.0;
    f32 y2r7 = 0.0;
    f32 er7 = 0.0;

    f32 bound(f32 v, f32 lo, f32 hi)
    {
        return fmax(lo, fmin(hi, v));
    }
    f32 q6(f32 v)
    {
        return floor(bound(v, 0.0, 1.0) * 63.0 + 0.5);
    }

    process
    {
        f32<> x = in;
        out = x;
        f32 sr = EC.samplerate;
        if (sr != p_sr)
        {
            // Band-pass filters (RBJ, 0 dB peak, Q 1.2) at 60, 150, 350, 800, 1.8k, 4k, 8k and 14 kHz.
            p_sr = sr;
            f32 w0 = 6.283185307 * fmin(60.0, 0.45 * sr) / sr;
            f32 al0 = sin(w0) / (2.0 * 1.2);
            f32 n0 = 1.0 + al0;
            b0_0 = al0 / n0;
            b2_0 = 0.0 - al0 / n0;
            a1_0 = -2.0 * cos(w0) / n0;
            a2_0 = (1.0 - al0) / n0;
            f32 w1 = 6.283185307 * fmin(150.0, 0.45 * sr) / sr;
            f32 al1 = sin(w1) / (2.0 * 1.2);
            f32 n1 = 1.0 + al1;
            b0_1 = al1 / n1;
            b2_1 = 0.0 - al1 / n1;
            a1_1 = -2.0 * cos(w1) / n1;
            a2_1 = (1.0 - al1) / n1;
            f32 w2 = 6.283185307 * fmin(350.0, 0.45 * sr) / sr;
            f32 al2 = sin(w2) / (2.0 * 1.2);
            f32 n2 = 1.0 + al2;
            b0_2 = al2 / n2;
            b2_2 = 0.0 - al2 / n2;
            a1_2 = -2.0 * cos(w2) / n2;
            a2_2 = (1.0 - al2) / n2;
            f32 w3 = 6.283185307 * fmin(800.0, 0.45 * sr) / sr;
            f32 al3 = sin(w3) / (2.0 * 1.2);
            f32 n3 = 1.0 + al3;
            b0_3 = al3 / n3;
            b2_3 = 0.0 - al3 / n3;
            a1_3 = -2.0 * cos(w3) / n3;
            a2_3 = (1.0 - al3) / n3;
            f32 w4 = 6.283185307 * fmin(1800.0, 0.45 * sr) / sr;
            f32 al4 = sin(w4) / (2.0 * 1.2);
            f32 n4 = 1.0 + al4;
            b0_4 = al4 / n4;
            b2_4 = 0.0 - al4 / n4;
            a1_4 = -2.0 * cos(w4) / n4;
            a2_4 = (1.0 - al4) / n4;
            f32 w5 = 6.283185307 * fmin(4000.0, 0.45 * sr) / sr;
            f32 al5 = sin(w5) / (2.0 * 1.2);
            f32 n5 = 1.0 + al5;
            b0_5 = al5 / n5;
            b2_5 = 0.0 - al5 / n5;
            a1_5 = -2.0 * cos(w5) / n5;
            a2_5 = (1.0 - al5) / n5;
            f32 w6 = 6.283185307 * fmin(8000.0, 0.45 * sr) / sr;
            f32 al6 = sin(w6) / (2.0 * 1.2);
            f32 n6 = 1.0 + al6;
            b0_6 = al6 / n6;
            b2_6 = 0.0 - al6 / n6;
            a1_6 = -2.0 * cos(w6) / n6;
            a2_6 = (1.0 - al6) / n6;
            f32 w7 = 6.283185307 * fmin(14000.0, 0.45 * sr) / sr;
            f32 al7 = sin(w7) / (2.0 * 1.2);
            f32 n7 = 1.0 + al7;
            b0_7 = al7 / n7;
            b2_7 = 0.0 - al7 / n7;
            a1_7 = -2.0 * cos(w7) / n7;
            a2_7 = (1.0 - al7) / n7;
        }
        // Band energies over about 200 ms.
        f32 ka = 1.0 - exp(-1.0 / (0.2 * sr));
        // Overall correlation over about 300 ms.
        f32 kc = 1.0 - exp(-1.0 / (0.3 * sr));
        e_lr = e_lr + kc * (x[0] * x[1] - e_lr);
        e_ll = e_ll + kc * (x[0] * x[0] - e_ll);
        e_rr = e_rr + kc * (x[1] * x[1] - e_rr);
        f32 corr = 0.0;
        if (e_ll > 0.00000001 && e_rr > 0.00000001)
        {
            corr = bound(e_lr / sqrt(e_ll * e_rr), -1.0, 1.0);
        }
        f32 yl0 = b0_0 * x[0] + b2_0 * x2l0 - a1_0 * y1l0 - a2_0 * y2l0;
        x2l0 = x1l0;
        x1l0 = x[0];
        y2l0 = y1l0;
        y1l0 = yl0;
        el0 = el0 + ka * (yl0 * yl0 - el0);
        f32 yr0 = b0_0 * x[1] + b2_0 * x2r0 - a1_0 * y1r0 - a2_0 * y2r0;
        x2r0 = x1r0;
        x1r0 = x[1];
        y2r0 = y1r0;
        y1r0 = yr0;
        er0 = er0 + ka * (yr0 * yr0 - er0);
        ex0 = ex0 + ka * (yl0 * yr0 - ex0);
        f32 al_0 = sqrt(el0);
        f32 ar_0 = sqrt(er0);
        f32 pan_0 = (ar_0 - al_0) / fmax(ar_0 + al_0, 0.0000001);
        f32 lv_0 = (10.0 * log10(fmax(el0 + er0, 0.000000000001)) + 60.0) / 60.0;
        f32 cb_0 = 1.0;
        if (el0 > 0.000000000001 && er0 > 0.000000000001)
        {
            cb_0 = bound(ex0 / sqrt(el0 * er0), -1.0, 1.0);
        }
        f32 code_0 = ((q6(lv_0) * 64.0 + q6((pan_0 + 1.0) * 0.5)) * 64.0) + q6((1.0 - cb_0) * 0.5);
        f32 yl1 = b0_1 * x[0] + b2_1 * x2l1 - a1_1 * y1l1 - a2_1 * y2l1;
        x2l1 = x1l1;
        x1l1 = x[0];
        y2l1 = y1l1;
        y1l1 = yl1;
        el1 = el1 + ka * (yl1 * yl1 - el1);
        f32 yr1 = b0_1 * x[1] + b2_1 * x2r1 - a1_1 * y1r1 - a2_1 * y2r1;
        x2r1 = x1r1;
        x1r1 = x[1];
        y2r1 = y1r1;
        y1r1 = yr1;
        er1 = er1 + ka * (yr1 * yr1 - er1);
        ex1 = ex1 + ka * (yl1 * yr1 - ex1);
        f32 al_1 = sqrt(el1);
        f32 ar_1 = sqrt(er1);
        f32 pan_1 = (ar_1 - al_1) / fmax(ar_1 + al_1, 0.0000001);
        f32 lv_1 = (10.0 * log10(fmax(el1 + er1, 0.000000000001)) + 60.0) / 60.0;
        f32 cb_1 = 1.0;
        if (el1 > 0.000000000001 && er1 > 0.000000000001)
        {
            cb_1 = bound(ex1 / sqrt(el1 * er1), -1.0, 1.0);
        }
        f32 code_1 = ((q6(lv_1) * 64.0 + q6((pan_1 + 1.0) * 0.5)) * 64.0) + q6((1.0 - cb_1) * 0.5);
        f32 yl2 = b0_2 * x[0] + b2_2 * x2l2 - a1_2 * y1l2 - a2_2 * y2l2;
        x2l2 = x1l2;
        x1l2 = x[0];
        y2l2 = y1l2;
        y1l2 = yl2;
        el2 = el2 + ka * (yl2 * yl2 - el2);
        f32 yr2 = b0_2 * x[1] + b2_2 * x2r2 - a1_2 * y1r2 - a2_2 * y2r2;
        x2r2 = x1r2;
        x1r2 = x[1];
        y2r2 = y1r2;
        y1r2 = yr2;
        er2 = er2 + ka * (yr2 * yr2 - er2);
        ex2 = ex2 + ka * (yl2 * yr2 - ex2);
        f32 al_2 = sqrt(el2);
        f32 ar_2 = sqrt(er2);
        f32 pan_2 = (ar_2 - al_2) / fmax(ar_2 + al_2, 0.0000001);
        f32 lv_2 = (10.0 * log10(fmax(el2 + er2, 0.000000000001)) + 60.0) / 60.0;
        f32 cb_2 = 1.0;
        if (el2 > 0.000000000001 && er2 > 0.000000000001)
        {
            cb_2 = bound(ex2 / sqrt(el2 * er2), -1.0, 1.0);
        }
        f32 code_2 = ((q6(lv_2) * 64.0 + q6((pan_2 + 1.0) * 0.5)) * 64.0) + q6((1.0 - cb_2) * 0.5);
        f32 yl3 = b0_3 * x[0] + b2_3 * x2l3 - a1_3 * y1l3 - a2_3 * y2l3;
        x2l3 = x1l3;
        x1l3 = x[0];
        y2l3 = y1l3;
        y1l3 = yl3;
        el3 = el3 + ka * (yl3 * yl3 - el3);
        f32 yr3 = b0_3 * x[1] + b2_3 * x2r3 - a1_3 * y1r3 - a2_3 * y2r3;
        x2r3 = x1r3;
        x1r3 = x[1];
        y2r3 = y1r3;
        y1r3 = yr3;
        er3 = er3 + ka * (yr3 * yr3 - er3);
        ex3 = ex3 + ka * (yl3 * yr3 - ex3);
        f32 al_3 = sqrt(el3);
        f32 ar_3 = sqrt(er3);
        f32 pan_3 = (ar_3 - al_3) / fmax(ar_3 + al_3, 0.0000001);
        f32 lv_3 = (10.0 * log10(fmax(el3 + er3, 0.000000000001)) + 60.0) / 60.0;
        f32 cb_3 = 1.0;
        if (el3 > 0.000000000001 && er3 > 0.000000000001)
        {
            cb_3 = bound(ex3 / sqrt(el3 * er3), -1.0, 1.0);
        }
        f32 code_3 = ((q6(lv_3) * 64.0 + q6((pan_3 + 1.0) * 0.5)) * 64.0) + q6((1.0 - cb_3) * 0.5);
        f32 yl4 = b0_4 * x[0] + b2_4 * x2l4 - a1_4 * y1l4 - a2_4 * y2l4;
        x2l4 = x1l4;
        x1l4 = x[0];
        y2l4 = y1l4;
        y1l4 = yl4;
        el4 = el4 + ka * (yl4 * yl4 - el4);
        f32 yr4 = b0_4 * x[1] + b2_4 * x2r4 - a1_4 * y1r4 - a2_4 * y2r4;
        x2r4 = x1r4;
        x1r4 = x[1];
        y2r4 = y1r4;
        y1r4 = yr4;
        er4 = er4 + ka * (yr4 * yr4 - er4);
        ex4 = ex4 + ka * (yl4 * yr4 - ex4);
        f32 al_4 = sqrt(el4);
        f32 ar_4 = sqrt(er4);
        f32 pan_4 = (ar_4 - al_4) / fmax(ar_4 + al_4, 0.0000001);
        f32 lv_4 = (10.0 * log10(fmax(el4 + er4, 0.000000000001)) + 60.0) / 60.0;
        f32 cb_4 = 1.0;
        if (el4 > 0.000000000001 && er4 > 0.000000000001)
        {
            cb_4 = bound(ex4 / sqrt(el4 * er4), -1.0, 1.0);
        }
        f32 code_4 = ((q6(lv_4) * 64.0 + q6((pan_4 + 1.0) * 0.5)) * 64.0) + q6((1.0 - cb_4) * 0.5);
        f32 yl5 = b0_5 * x[0] + b2_5 * x2l5 - a1_5 * y1l5 - a2_5 * y2l5;
        x2l5 = x1l5;
        x1l5 = x[0];
        y2l5 = y1l5;
        y1l5 = yl5;
        el5 = el5 + ka * (yl5 * yl5 - el5);
        f32 yr5 = b0_5 * x[1] + b2_5 * x2r5 - a1_5 * y1r5 - a2_5 * y2r5;
        x2r5 = x1r5;
        x1r5 = x[1];
        y2r5 = y1r5;
        y1r5 = yr5;
        er5 = er5 + ka * (yr5 * yr5 - er5);
        ex5 = ex5 + ka * (yl5 * yr5 - ex5);
        f32 al_5 = sqrt(el5);
        f32 ar_5 = sqrt(er5);
        f32 pan_5 = (ar_5 - al_5) / fmax(ar_5 + al_5, 0.0000001);
        f32 lv_5 = (10.0 * log10(fmax(el5 + er5, 0.000000000001)) + 60.0) / 60.0;
        f32 cb_5 = 1.0;
        if (el5 > 0.000000000001 && er5 > 0.000000000001)
        {
            cb_5 = bound(ex5 / sqrt(el5 * er5), -1.0, 1.0);
        }
        f32 code_5 = ((q6(lv_5) * 64.0 + q6((pan_5 + 1.0) * 0.5)) * 64.0) + q6((1.0 - cb_5) * 0.5);
        f32 yl6 = b0_6 * x[0] + b2_6 * x2l6 - a1_6 * y1l6 - a2_6 * y2l6;
        x2l6 = x1l6;
        x1l6 = x[0];
        y2l6 = y1l6;
        y1l6 = yl6;
        el6 = el6 + ka * (yl6 * yl6 - el6);
        f32 yr6 = b0_6 * x[1] + b2_6 * x2r6 - a1_6 * y1r6 - a2_6 * y2r6;
        x2r6 = x1r6;
        x1r6 = x[1];
        y2r6 = y1r6;
        y1r6 = yr6;
        er6 = er6 + ka * (yr6 * yr6 - er6);
        ex6 = ex6 + ka * (yl6 * yr6 - ex6);
        f32 al_6 = sqrt(el6);
        f32 ar_6 = sqrt(er6);
        f32 pan_6 = (ar_6 - al_6) / fmax(ar_6 + al_6, 0.0000001);
        f32 lv_6 = (10.0 * log10(fmax(el6 + er6, 0.000000000001)) + 60.0) / 60.0;
        f32 cb_6 = 1.0;
        if (el6 > 0.000000000001 && er6 > 0.000000000001)
        {
            cb_6 = bound(ex6 / sqrt(el6 * er6), -1.0, 1.0);
        }
        f32 code_6 = ((q6(lv_6) * 64.0 + q6((pan_6 + 1.0) * 0.5)) * 64.0) + q6((1.0 - cb_6) * 0.5);
        f32 yl7 = b0_7 * x[0] + b2_7 * x2l7 - a1_7 * y1l7 - a2_7 * y2l7;
        x2l7 = x1l7;
        x1l7 = x[0];
        y2l7 = y1l7;
        y1l7 = yl7;
        el7 = el7 + ka * (yl7 * yl7 - el7);
        f32 yr7 = b0_7 * x[1] + b2_7 * x2r7 - a1_7 * y1r7 - a2_7 * y2r7;
        x2r7 = x1r7;
        x1r7 = x[1];
        y2r7 = y1r7;
        y1r7 = yr7;
        er7 = er7 + ka * (yr7 * yr7 - er7);
        ex7 = ex7 + ka * (yl7 * yr7 - ex7);
        f32 al_7 = sqrt(el7);
        f32 ar_7 = sqrt(er7);
        f32 pan_7 = (ar_7 - al_7) / fmax(ar_7 + al_7, 0.0000001);
        f32 lv_7 = (10.0 * log10(fmax(el7 + er7, 0.000000000001)) + 60.0) / 60.0;
        f32 cb_7 = 1.0;
        if (el7 > 0.000000000001 && er7 > 0.000000000001)
        {
            cb_7 = bound(ex7 / sqrt(el7 * er7), -1.0, 1.0);
        }
        f32 code_7 = ((q6(lv_7) * 64.0 + q6((pan_7 + 1.0) * 0.5)) * 64.0) + q6((1.0 - cb_7) * 0.5);
        code_0 = code_0 + q6((corr + 1.0) * 0.5) * 262144.0;
        f32 s = 1.0 / 16777216.0;
        display = <code_0 * s, code_1 * s, code_2 * s, code_3 * s>;
        display2 = <code_4 * s, code_5 * s, code_6 * s, code_7 * s>;
    }
}
