// Signed number with one decimal (|val| < 100), top-left at o, digit height h.
float number(float2 p, float2 o, float h, float val) {
    float w = h * .5;
    float adv = w * 1.2;
    float2 s = p - o - float2(w * .4, 0.);   // narrow figures: keep the old centre
    float a = abs(val);
    float t10 = floor(a * 10. + .5);
    float hund = floor(t10 / 100.);
    float ones = mod(floor(t10 / 10.), 10.);
    float tenth = mod(t10, 10.);
    float lit = 0.;
    if (val < -.049) lit = 1. - smoothstep(.075, .135, sdseg(s / w, float2(.1, 1.), float2(.8, 1.)));
    if (val > .049) {
        float pl = min(sdseg(s / w, float2(.1, 1.), float2(.8, 1.)), sdseg(s / w, float2(.45, .65), float2(.45, 1.35)));
        lit = 1. - smoothstep(.075, .135, pl);
    }
    lit = max(lit, digit((s - float2(adv, 0.)) / w, hund > .5 ? hund : -1.));
    lit = max(lit, digit((s - float2(2. * adv, 0.)) / w, ones));
    float dd = length(s - float2(2. * adv + w * 1.02, h * .93));
    lit = max(lit, 1. - smoothstep(h * .07, h * .11, dd));
    lit = max(lit, digit((s - float2(2. * adv + w * 1.2, 0.)) / w, tenth));
    return lit;
}

void put(inout float3 col, inout float a, float3 c, float ca) {
    float na = ca + a * (1. - ca);
    if (na > .001) col = (c * ca + col * a * (1. - ca)) / na;
    a = na;
}
float3 ramp(float t) {
    float3 c = mix(float3(.22, .52, .82), float3(.42, .74, .95), smoothstep(0., .75, t));
    c = mix(c, float3(.98, .60, .16), smoothstep(.78, .88, t));
    return t > .93 ? float3(.95, .32, .20) : c;
}
// One vertical bar from y0 (bottom) to y1 (top) with its fill, in a well.
void bar(inout float3 col, inout float a, float2 p, float x0, float x1, float y0, float y1, float lv) {
    if (p.x < x0 || p.x > x1 || p.y > y1 || p.y < y0) return;
    float t = (y1 - p.y) / (y1 - y0);
    put(col, a, float3(.040, .042, .048), 1.);
    if (t < lv) put(col, a, ramp(t), 1.);
    else if (abs(mod(t * 11., 1.)) < .05 && t > .02 && t < .98) put(col, a, float3(.10, .12, .14), 1.);
}

half4 main(float2 fragCoord) {
    float2 uv = fragCoord / iResolution.xy;
    bool wide = iResolution.x / iResolution.y > .3;
    // 8 design units per grid unit; both meters are 352 tall so their bars match.
    float2 p = uv * float2(wide ? 168. : 64., 352.);
    float3 col = float3(0.);
    float a = 0.;
    float3 text = float3(.80, .82, .84);
    float3 dim = float3(.30, .31, .33);
    float3 warn = float3(.98, .52, .14);
    float bx = wide ? 6. : 14.;
    bar(col, a, p, bx, bx + 16., 28., 348., audioLow.x);
    bar(col, a, p, bx + 20., bx + 36., 28., 348., audioLow.y);
    // Peak-hold number above the bars.
    float pkdb = audioMedium.x * 100.;
    float lit = 0.;
    if (pkdb > -59.) {
        lit = number(p, float2(bx - 1., 6.), 14., pkdb);
        put(col, a, pkdb > -.05 ? warn : text, lit);
    } else {
        float d = sdseg(p, float2(bx + 12., 13.), float2(bx + 24., 13.));
        put(col, a, dim, 1. - smoothstep(.8, 1.6, d));
    }
    if (wide) {
        float3 lite = float3(.42, .74, .95);
        // Short-term loudness, large.
        put(col, a, dim * 2., word(p, 100., 36., 16., 12., 21., 6., 19., 0., 0.));
        float lufs = audioLow.w * 60. - 60.;
        if (audioLow.w > .002) put(col, a, lite, number(p, float2(56., 58.), 40., lufs));
        else put(col, a, dim, 1. - smoothstep(.8, 1.6, sdseg(p, float2(70., 78.), float2(110., 78.))));
        // True peak (held 5 s), large.
        put(col, a, dim * 2., word(p, 80., 196., 16., 20., 18., 21., 5., 0., 0.));
        put(col, a, dim * 2., word(p, 130., 196., 16., 16., 11., 0., 0., 0., 0.));
        float tpdb = audioMedium.y * 100.;
        float3 tpc = tpdb > -.05 ? float3(.95, .32, .20) : (tpdb > -1. ? float3(.98, .52, .14) : lite);
        if (tpdb > -59.) put(col, a, tpc, number(p, float2(56., 218.), 40., tpdb));
        else put(col, a, dim, 1. - smoothstep(.8, 1.6, sdseg(p, float2(70., 238.), float2(110., 238.))));
    }
    return half4(half3(col * a), half(a));
}
