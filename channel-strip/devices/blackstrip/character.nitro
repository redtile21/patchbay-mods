component eb_character
{
    audio_inport in;
    audio_inport f32 amount = 50.0;
    value_inport i32 character;
    value_inport bool enabled;
    value_inport bool oversampling;

    audio_outport out;

    f32 p_sr = 0.0;
    // one-pole high cut, tape low bump, DC blocker
    f32<2> hc = 0.0;
    f32<2> lb = 0.0;
    f32<2> dc_x = 0.0;
    f32<2> dc_y = 0.0;
    f32<2> px = 0.0;          // previous input, for 2x
    f32 k_hc_an = 0.0;
    f32 k_hc_tu = 0.0;
    f32 k_hc_ta = 0.0;
    f32 k_lb = 0.0;
    f32 k_dc = 0.0;

    // Exact hyperbolic tangent from exp (Nitro folds tanh only on constants); clamped so exp cannot overflow.
    f32 soft(f32 v)
    {
        f32 e = exp(2.0 * fmax(-10.0, fmin(10.0, v)));
        return (e - 1.0) / (e + 1.0);
    }

    // The voiced curve at one point, level kept at low levels.
    f32 sat(f32 v, f32 drive, f32 bias, f32 sb)
    {
        return (soft(v * drive + bias) - sb) / drive;
    }

    process
    {
        f32 sr = EC.samplerate;
        if (sr != p_sr)
        {
            p_sr = sr;
            k_hc_an = 1.0 - exp(-6.283185307 * fmin(20000.0, 0.45 * sr) / sr);
            k_hc_tu = 1.0 - exp(-6.283185307 * fmin(16000.0, 0.45 * sr) / sr);
            k_hc_ta = 1.0 - exp(-6.283185307 * 12000.0 / sr);
            k_lb = 1.0 - exp(-6.283185307 * 90.0 / sr);
            k_dc = exp(-6.283185307 * 8.0 / sr);
        }
        f32<> x = in;
        f32<> xin = in;

        // Character (0 Clean, 1 Analog, 2 Tube, 3 Tape): gentle saturation with level kept at low levels.
        // Amount 50 % is the voicing below; 0 % is clean, 100 % doubles the drive, bias and colour.
        f32 am = fmax(0.0, fmin(100.0, amount)) * 0.02;
        if (character > 0 && enabled && am > 0.0001)
        {
            f32 drive = 1.4;
            f32 bias = 0.03;
            f32 khc = k_hc_an;
            if (character == 2) { drive = 1.8; bias = 0.15; khc = k_hc_tu; }
            if (character == 3) { drive = 1.6; bias = 0.05; khc = k_hc_ta; }
            drive = 1.0 + (drive - 1.0) * am;
            bias = bias * am;
            f32 sb = soft(bias);
            f32 y_l = sat(x[0], drive, bias, sb);
            f32 y_r = sat(x[1], drive, bias, sb);
            if (oversampling)
            {
                // 2x: average what the curve adds at this sample and halfway to the previous one (less aliasing).
                f32 m_l = 0.5 * (x[0] + px[0]);
                f32 m_r = 0.5 * (x[1] + px[1]);
                y_l = x[0] + 0.5 * ((y_l - x[0]) + (sat(m_l, drive, bias, sb) - m_l));
                y_r = x[1] + 0.5 * ((y_r - x[1]) + (sat(m_r, drive, bias, sb) - m_r));
            }
            f32<> y = <y_l, y_r>;
            // DC blocker (the bias adds a little offset)
            f32<> yb = y - dc_x + dc_y * k_dc;
            dc_x = y;
            dc_y = yb;
            hc = hc + khc * (yb - hc);
            y = yb + (hc - yb) * fmin(1.0, am);
            if (character == 3)
            {
                lb = lb + k_lb * (y - lb);
                y = y + lb * (0.19 * am);          // about +1.5 dB below 90 Hz at 50 %
            }
            x = y;
        }
        px = xin;
        out = x;
    }
}
