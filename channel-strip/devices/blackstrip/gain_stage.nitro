component eb_gain_stage
{
    audio_inport in;
    audio_inport ref;
    audio_inport f32 gain_db = 0.0;
    value_inport bool match;

    audio_outport out;
    audio_outport f32<4> display;

    f32 p_sr = 0.0;
    f32 b0 = 1.0;
    f32 b1 = 0.0;
    f32 b2 = 0.0;
    f32 a1 = 0.0;
    f32 a2 = 0.0;
    f32 c1 = 0.0;
    f32 c2 = 0.0;
    f32 k_s = 0.0;
    f32 k_g = 0.0;
    f32<2> iz1 = 0.0;
    f32<2> iz2 = 0.0;
    f32<2> iz3 = 0.0;
    f32<2> iz4 = 0.0;
    f32<2> oz1 = 0.0;
    f32<2> oz2 = 0.0;
    f32<2> oz3 = 0.0;
    f32<2> oz4 = 0.0;
    f32 ms_in = 0.0;
    f32 ms_out = 0.0;
    f32 match_db = 0.0;
    f32 applied = 1.0;
    f32 shown_db = 0.0;
    process
    {
        f32 sr = EC.samplerate;
        if (sr != p_sr)
        {
            p_sr = sr;
            // ITU-R BS.1770 K-weighting, as in the meter: high shelf, then 38 Hz high-pass.
            f32 w1 = 3.141592654 * 1681.9744509555319 / sr;
            f32 kk1 = sin(w1) / cos(w1);
            f32 q1 = 0.7071752369554196;
            f32 vh = exp(3.999843853973347 * 0.11512925464970229);
            f32 vb = exp(log(vh) * 0.4996667741545416);
            f32 a0_1 = 1.0 + kk1 / q1 + kk1 * kk1;
            b0 = (vh + vb * kk1 / q1 + kk1 * kk1) / a0_1;
            b1 = 2.0 * (kk1 * kk1 - vh) / a0_1;
            b2 = (vh - vb * kk1 / q1 + kk1 * kk1) / a0_1;
            a1 = 2.0 * (kk1 * kk1 - 1.0) / a0_1;
            a2 = (1.0 - kk1 / q1 + kk1 * kk1) / a0_1;
            f32 w2 = 3.141592654 * 38.13547087613982 / sr;
            f32 kk2 = sin(w2) / cos(w2);
            f32 q2 = 0.5003270373253953;
            f32 a0_2 = 1.0 + kk2 / q2 + kk2 * kk2;
            c1 = 2.0 * (kk2 * kk2 - 1.0) / a0_2;
            c2 = (1.0 - kk2 / q2 + kk2 * kk2) / a0_2;
            // Loudness over about 3 s (short-term); the correction follows over about 1.5 s.
            k_s = 1.0 - exp(-1.0 / (1.5 * sr));
            k_g = 1.0 - exp(-1.0 / (1.5 * sr));
        }
        f32<> x = in;

        f32<> r = ref;

        // K-weighted mean square of the strip's input (ref) and of its output before this stage (x).
        f32<> s1 = b0 * r + iz1;
        iz1 = b1 * r - a1 * s1 + iz2;
        iz2 = b2 * r - a2 * s1;
        f32<> s2 = s1 + iz3;
        iz3 = -2.0 * s1 - c1 * s2 + iz4;
        iz4 = s1 - c2 * s2;
        f32<> t1 = b0 * x + oz1;
        oz1 = b1 * x - a1 * t1 + oz2;
        oz2 = b2 * x - a2 * t1;
        f32<> t2 = t1 + oz3;
        oz3 = -2.0 * t1 - c1 * t2 + oz4;
        oz4 = t1 - c2 * t2;
        ms_in = ms_in + k_s * (s2[0] * s2[0] + s2[1] * s2[1] - ms_in);
        ms_out = ms_out + k_s * (t2[0] * t2[0] + t2[1] * t2[1] - ms_out);

        // Match: move toward the loudness difference while both sides have signal (above about -60 LUFS); hold in silence.
        f32 target = 0.0;
        if (match)
        {
            target = match_db;
            if (ms_in > 0.000001 && ms_out > 0.000001)
            {
                target = fmin(24.0, fmax(-24.0, 10.0 * log10(ms_in / ms_out)));
            }
        }
        match_db = target;
        f32 g = fmin(24.0, fmax(-24.0, gain_db)) + match_db;
        f32 lin = exp(g * 0.11512925);
        applied = applied + k_g * (lin - applied);
        out = x * applied;
        // For the output meter: Match on/off and the match gain (smoothed like the gain itself), -24..+24 dB as 0..1.
        shown_db = shown_db + k_g * (match_db - shown_db);
        f32 on = 0.0;
        if (match)
        {
            on = 1.0;
        }
        display = <on, (fmin(24.0, fmax(-24.0, shown_db)) + 24.0) / 48.0, 0.0, 0.0>;
    }
}
